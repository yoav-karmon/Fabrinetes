#!/bin/bash
SCRIPT_PATH="$(readlink -f "$0")"
TASKS_DIR="$(dirname "$SCRIPT_PATH")"
LOG_DIR="$TASKS_DIR/_log"
LOGFILE="$LOG_DIR/fabrinetes_$(date +%Y-%m-%d).log"

export HDLFORGE_ORIG_PATH="$(pwd)"
export FABRINETES_CALLED="true"

# Validate that we're running from the correct location
if [[ ! -d "$TASKS_DIR/source" || ! -d "$TASKS_DIR/containers" ]]; then
    echo "[!x!]  Error: fabrinetes must be run from the directory containing 'source/' and 'containers/'"
    echo "Current directory: $(pwd)"
    echo "Script location: $TASKS_DIR"
    echo "Required directories:"
    echo "  - $TASKS_DIR/source (missing: $([[ ! -d "$TASKS_DIR/source" ]] && echo "YES" || echo "NO"))"
    echo "  - $TASKS_DIR/containers (missing: $([[ ! -d "$TASKS_DIR/containers" ]] && echo "YES" || echo "NO"))"
    echo ""
    echo "Please run fabrinetes from the correct directory."
    exit 1
fi

# Create log directory if it doesn't exist
mkdir -p "$LOG_DIR"

# Change to the tasks directory before running invoke
cd "$TASKS_DIR" || {
    echo "[!x!]  Failed to cd into $TASKS_DIR"
    echo "run update_repo_path correctly."
    exit 1
}

# Check if no arguments provided
if [[ $# -eq 0 ]]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks help" | tee -a "$LOGFILE"
    invoke -c tasks help | tee -a "$LOGFILE"
else
    # Handle build command with repo parameter
    if [[ "$1" == "build" && -n "$2" ]]; then
        # Check if --dry-run flag is present
        if [[ "$*" == *"--dry-run"* ]]; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks build --repo=$2 --dry-run" >> "$LOGFILE"
            invoke -c tasks build --repo="$2" --dry-run | tee -a "$LOGFILE"
        # Check if --export flag is present
        elif [[ "$*" == *"--export"* ]]; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks build --repo=$2 --export" >> "$LOGFILE"
            invoke -c tasks build --repo="$2" --export | tee -a "$LOGFILE"
        else
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks build --repo=$2" >> "$LOGFILE"
            invoke -c tasks build --repo="$2" | tee -a "$LOGFILE"
        fi
    # Handle restore command
    elif [[ "$1" == "restore" && -n "$2" ]]; then
        repo_name="$2"
        shift  # Remove 'restore' from arguments
        shift  # Remove repository name from arguments
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks restore --repo=$repo_name $*" >> "$LOGFILE"
        invoke -c tasks restore --repo="$repo_name" "$@" | tee -a "$LOGFILE"
    # Handle commit command
    elif [[ "$1" == "commit" ]]; then
        shift  # Remove 'commit' from arguments
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks commit $*" >> "$LOGFILE"
        invoke -c tasks commit "$@" | tee -a "$LOGFILE"
    # Handle exec command
    elif [[ "$1" == "exec" ]]; then
        shift  # Remove 'exec' from arguments
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks exec $*" >> "$LOGFILE"
        invoke -c tasks exec "$@" | tee -a "$LOGFILE"
    # Handle shell command
    elif [[ "$1" == "shell" ]]; then
        shift  # Remove 'shell' from arguments
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks shell $*" >> "$LOGFILE"
        invoke -c tasks shell "$@" | tee -a "$LOGFILE"
    else
        # Run invoke as if we were in that directory
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks $*" >> "$LOGFILE"
        exec invoke -c tasks "$@" | tee -a "$LOGFILE"
    fi
fi

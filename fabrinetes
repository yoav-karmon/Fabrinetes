#!/bin/bash
SCRIPT_PATH="$(readlink -f "$0")"
TASKS_DIR="$(dirname "$SCRIPT_PATH")"
LOG_DIR="$TASKS_DIR/_log"
LOGFILE="$LOG_DIR/fabrinetes_$(date +%Y-%m-%d).log"

export HDLFORGE_ORIG_PATH="$(pwd)"
export FABRINETES_CALLED="true"

# Validate that we're running from the correct location
if [[ ! -d "$TASKS_DIR/source" || ! -d "$TASKS_DIR/containers" ]]; then
    echo "[!x!]  Error: fabrinetes must be run from the directory containing 'source/' and 'containers/'"
    echo "Current directory: $(pwd)"
    echo "Script location: $TASKS_DIR"
    echo "Required directories:"
    echo "  - $TASKS_DIR/source (missing: $([[ ! -d "$TASKS_DIR/source" ]] && echo "YES" || echo "NO"))"
    echo "  - $TASKS_DIR/containers (missing: $([[ ! -d "$TASKS_DIR/containers" ]] && echo "YES" || echo "NO"))"
    echo ""
    echo "Please run fabrinetes from the correct directory."
    exit 1
fi

# Create log directory if it doesn't exist
mkdir -p "$LOG_DIR"

# Change to the tasks directory before running invoke
cd "$TASKS_DIR" || {
    echo "[!x!]  Failed to cd into $TASKS_DIR"
    echo "run update_repo_path correctly."
    exit 1
}

# Check if no arguments provided
if [[ $# -eq 0 ]]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks help" | tee -a "$LOGFILE"
    invoke -c tasks help | tee -a "$LOGFILE"
else
    # Handle gen-image command with config file parameter
    if [[ "$1" == "gen-image" && -n "$2" ]]; then
        # Gen-image command arguments
        gen_image_args="--config-file=$2"
        
        # Add flags if present
        if [[ "$*" == *"--dry-run"* ]]; then
            gen_image_args="$gen_image_args --dry-run"
        fi
        if [[ "$*" == *"--base-image"* ]]; then
            gen_image_args="$gen_image_args --base-image"
        fi
        
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks gen-image $gen_image_args" >> "$LOGFILE"
        invoke -c tasks gen-image $gen_image_args | tee -a "$LOGFILE"
    # Handle commit command
    elif [[ "$1" == "commit" ]]; then
        shift  # Remove 'commit' from arguments
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks commit $*" >> "$LOGFILE"
        invoke -c tasks commit "$@" | tee -a "$LOGFILE"
    # Handle exec command
    elif [[ "$1" == "exec" ]]; then
        shift  # Remove 'exec' from arguments
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks exec $*" >> "$LOGFILE"
        invoke -c tasks exec "$@" | tee -a "$LOGFILE"
    # Handle shell command
    elif [[ "$1" == "shell" ]]; then
        shift  # Remove 'shell' from arguments
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks shell $*" >> "$LOGFILE"
        invoke -c tasks shell "$@" | tee -a "$LOGFILE"
    # Handle pkg command
    elif [[ "$1" == "pkg" ]]; then
        shift  # Remove 'pkg' from arguments
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks pkg $*" >> "$LOGFILE"
        invoke -c tasks pkg "$@" | tee -a "$LOGFILE"
    # Handle clean-image command
    elif [[ "$1" == "clean-image" && -n "$2" ]]; then
        image_name="$2"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks clean-image --image=$image_name" >> "$LOGFILE"
        invoke -c tasks clean-image --image="$image_name" | tee -a "$LOGFILE"
    # Handle kill command
    elif [[ "$1" == "kill" && -n "$2" ]]; then
        container_name="$2"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks kill --container-name=$container_name" >> "$LOGFILE"
        invoke -c tasks kill --container-name="$container_name" | tee -a "$LOGFILE"
    # Handle clean command
    elif [[ "$1" == "clean" ]]; then
        # Check for help flag first
        if [[ "$*" == *"--help"* ]]; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks clean --help" >> "$LOGFILE"
            invoke -c tasks clean --help | tee -a "$LOGFILE"
        elif [[ -n "$2" ]]; then
            # Clean command arguments
            clean_args="--config-file=$2"
            
            # Add flags if present
            if [[ "$*" == *"--base-image"* ]]; then
                clean_args="$clean_args --base-image"
            fi
            if [[ "$*" == *"--image"* ]]; then
                clean_args="$clean_args --image"
            fi
            if [[ "$*" == *"--container"* ]]; then
                clean_args="$clean_args --container"
            fi
            if [[ "$*" == *"--all"* ]]; then
                clean_args="$clean_args --all"
            fi
            if [[ "$*" == *"--dangling"* ]]; then
                clean_args="$clean_args --dangling"
            fi
            
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks clean $clean_args" >> "$LOGFILE"
            invoke -c tasks clean $clean_args | tee -a "$LOGFILE"
        else
            echo "❌ Error: Config file is required for clean command"
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks clean --help" >> "$LOGFILE"
            invoke -c tasks clean --help | tee -a "$LOGFILE"
        fi
    else
        # Run invoke as if we were in that directory
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] \$ invoke -c tasks $*" >> "$LOGFILE"
        invoke -c tasks "$@" | tee -a "$LOGFILE"
        exit ${PIPESTATUS[0]}
    fi
fi

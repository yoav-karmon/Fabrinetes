{
  "name": "fabrinetes-run",
  "image": "fabrinetes-dev:local",
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.codex ${localEnv:HOME}/vscode-server-container/.vscode-server",
  "containerEnv": {
    "CONTAINER_USER": "${localEnv:USER}",
    "CONTAINER_HOME": "/home/${localEnv:USER}",
    "CODEX_HOME": "/home/${localEnv:USER}/.codex",
    "FABRINETES": "/home/${localEnv:USER}/repo/fpga/git-sub-module/Fabrinetes",
    "FABRINETES_ROOT": "/home/${localEnv:USER}/repo/fpga/git-sub-module/Fabrinetes"
  },
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": true,
  "workspaceMount": "",
  "workspaceFolder": "/home/${localEnv:USER}/repo/fpga/git-sub-module/Fabrinetes",
  "overrideCommand": false,
  "postStartCommand": "true",
  "runArgs": [
    "--pull=never",
    "--name", "${localEnv:USER}_fabrinetes_dev.run",
    "--hostname", "Fabrinetes",
    "--network=host",
    "--privileged"
  ],
  "mounts": [
    "source=/DATA/amd,target=/DATA/amd,type=bind",
    "source=/tmp,target=/tmp,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/${localEnv:USER}/.ssh,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/${localEnv:USER}/.codex,type=bind",
    "source=${localEnv:HOME}/vscode-server-container/.vscode-server,target=/home/${localEnv:USER}/.vscode-server,type=bind",
    "source=${localWorkspaceFolder}/../..,target=/home/${localEnv:USER}/repo/fpga,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/fabrinetes-run/bashrc-func,target=/etc/bashrc-func,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/fabrinetes-run/bashrc-root,target=/home/${localEnv:USER}/.bashrc,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/fabrinetes-run/init_env.sh,target=/etc/profile.d/init_env.sh,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/fabrinetes-run/entrypoint.sh,target=/usr/local/bin/entrypoint.sh,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  }
}

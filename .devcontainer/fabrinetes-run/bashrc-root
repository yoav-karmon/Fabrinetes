# Function helpers for PATH management, repo detection, and prompt support.
source /etc/bashrc-func
iprint "bashrc-root: started"

# Capture whether INIT_PATH existed before this shell sourced bashrc.
_INIT_PATH_WAS_DEFINED=${INIT_PATH:+yes}

if [ -r /etc/hostname ]; then
    HOSTNAME_ENTRY=$(tr -d '\n ' < /etc/hostname)
else
    HOSTNAME_ENTRY="${HOSTNAME}"
fi
export HOSTNAME_ENTRY

init_print "bashrc-root: sourcing init_env.sh"
if [ -f /etc/profile.d/init_env.sh ]; then
    # shellcheck disable=SC1091
    source /etc/profile.d/init_env.sh
fi

if [ -n "$PATH" ]; then
    export PATH=$(remove_duplicates_from_path "$PATH")
fi
if [ -n "$PYTHONPATH" ]; then
    export PYTHONPATH=$(remove_duplicates_from_path "$PYTHONPATH")
fi

init_print "bashrc-root: this is bashrc first run in session start"
if [ -z "$INIT_PATH" ] && [ -z "$BASHRC_INITIALIZED" ]; then
    if [ -n "$PATH" ]; then
        INIT_PATH=$(remove_duplicates_from_path "$PATH")
        export INIT_PATH
    else
        export INIT_PATH=""
    fi

    if [ -n "$PYTHONPATH" ]; then
        INIT_PYTHONPATH=$(remove_duplicates_from_path "$PYTHONPATH")
        export INIT_PYTHONPATH
    else
        export INIT_PYTHONPATH=""
    fi

    export BASHRC_INITIALIZED=1
fi

export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"
export GIT_CONFIG_SYSTEM="/etc/gitconfig"
export GIT_AUTHOR_NAME="${USER:-$(id -un)}"
export GIT_AUTHOR_EMAIL="${USER:-$(id -un)}@${HOSTNAME_ENTRY}"
export GIT_COMMITTER_NAME="${USER:-$(id -un)}"
export GIT_COMMITTER_EMAIL="${USER:-$(id -un)}@${HOSTNAME_ENTRY}"
export EDITOR="${EDITOR:-nano}"
export PAGER="${PAGER:-less}"

init_print "bashrc-root: ensuring gitconfig exists"
if [ ! -f "$HOME/.gitconfig" ]; then
    git config --global user.name "${USER:-$(id -un)}" || true
    git config --global user.email "${USER:-$(id -un)}@${HOSTNAME_ENTRY}" || true
    git config --global init.defaultBranch main || true
    git config --global core.autocrlf false || true
    git config --global core.filemode false || true
fi

HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s checkwinsize

[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
        color_prompt=yes
    else
        color_prompt=
    fi
fi

if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

update_repo_path

if [ -f "$FABRINETES/hdlforge/project_setup/hdlforge_completion.bash" ]; then
    # shellcheck disable=SC1090
    source "$FABRINETES/hdlforge/project_setup/hdlforge_completion.bash"
fi

export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"

init_print "bashrc-root: setting PS1"
PS1='\[\033[1;35m\]\u@${HOSTNAME_ENTRY}-${HOSTNAME_server}\[\033[0m\]:\[\033[1;33m\]\w\[\033[0m\] \[\033[1;36m\]$(parse_git_branch)\[\033[0m\]\$ '

print_env_vars
print_key_env_vars
iprint "bashrc-root: completed successfully"
iprint ""

{
  "vivado_version": "2025.1",
  "output_root": "compilation",
  "runs": {
    "synth_example": {
      "script": "compilation/synth_example/run.tcl",
      "sources": [
        "sources/RTL/top.sv",
        "sources/RTL/helper.vhd",
        "compilation/ip_example/latest/work/ip_sources/0/example.xcix",
        "sources/XDC/synthesis.xdc",
        "compilation/synth_example/ip_keep_hierarchy.xdc",
        "sources/RTL/build_defines.svh",
        "sources/data/init.mem"
      ],
      "enabled_on_all": true,
      "impl_runs": {
        "impl_example": {
          "script": "compilation/synth_example/impl_run_example.tcl",
          "sources": [
            "compilation/ip_example/latest/work/ip_sources/0/example.xcix",
            "sources/XDC/implementation.xdc"
          ],
          "enabled_on_all": true
        }
      }
    },
    "ip_example": {
      "script": "compilation/ip_example/run.tcl",
      "sources": [
        "sources/ip/example.xcix"
      ],
      "kind": "ip",
      "enabled_on_all": true
    }
  }
}

#!/bin/bash

set -o pipefail

# Resolve symlinks so fresh shells and recursive commands use this installation.
HDLFORGE_INSTALL_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
export FABRINETES="$(cd "$HDLFORGE_INSTALL_DIR/../.." && pwd -P)"
export HDLFORGE="$HDLFORGE_INSTALL_DIR"
source "$HDLFORGE_INSTALL_DIR/hdlforge_environment.bash"

# Validate the launch location even when a nested command inherited REPO_TOP.
launch_repo="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo 'error: HDLForge must run inside a Git repository' >&2
    exit 1
}
if [ "${HDLFORGE_CALLED:-0}" = 1 ] && [ "${REPO_TOP:-}" != "$launch_repo" ]; then
    echo 'error: nested HDLForge cannot reuse an environment from another repository' >&2
    exit 1
fi

if [ "${HDLFORGE_ENV_STATE_ACTIVE:-0}" != "1" ]; then
    unset HDLFORGE_ADD_PYTHONPATH
    unset HDLFORGE_ADD_PATH
    unset HDLFORGE_ADD_ENV_JSON
    unset HDLFORGE_ADD_ENV_VAR_JSON
fi

HDLFORGE_ENV_PYTHON_JSONS=()
HDLFORGE_ENV_PATH_JSONS=()
HDLFORGE_ENV_VAR_JSONS=()
HDLFORGE_COLLECTED_PYTHONPATHS=()
HDLFORGE_COLLECTED_PATHS=()
HDLFORGE_COLLECTED_ENV_KEYS=()
HDLFORGE_COLLECTED_ENV_VALUES=()
DRY_RUN=false
if [[ -n "${HDLFORGE_DRY_RUN:-}" && "${HDLFORGE_DRY_RUN:-0}" != "0" ]]; then
    DRY_RUN=true
    export HDLFORGE_DRY_RUN=1
fi

hdlforge_warn() {
    if [[ -v HDLFORGE_DEBUG ]]; then
        echo "$@"
    fi
}

hdlforge_shell_quote_args() {
    local arg
    local quoted_arg
    local command_text=""

    for arg in "$@"; do
        printf -v quoted_arg '%q' "$arg"
        if [ -z "$command_text" ]; then
            command_text="$quoted_arg"
        else
            command_text="${command_text} ${quoted_arg}"
        fi
    done

    printf '%s' "$command_text"
}

hdlforge_add_to_bashrc_path() {
    local bashrc_file="${HOME:?HDLForge requires HOME}/.bashrc"
    local managed_tag="# hdlforge-path"
    local desired_line="export PATH=\"${HDLFORGE_INSTALL_DIR}:\$PATH\" ${managed_tag}"
    local marker_count
    local matching_count
    local legacy_count
    local unsupported_count
    local temporary_file
    local original_mode

    if [ -e "$bashrc_file" ] && [ ! -f "$bashrc_file" ]; then
        echo "[!x!] Error: ~/.bashrc is not a regular file: $bashrc_file" >&2
        return 1
    fi

    if [ -f "$bashrc_file" ]; then
        marker_count="$(grep -F -c "$managed_tag" "$bashrc_file" || true)"
        matching_count="$(grep -F -x -c "$desired_line" "$bashrc_file" || true)"
        unsupported_count="$(awk -v managed_tag="$managed_tag" '
            index($0, managed_tag) || index($0, "# hdlforge-completion") { next }
            /hdlforge\/project_setup/ && !/^[[:space:]]*(export[[:space:]]+)?PATH=["\047]?[^:"\047]*\/hdlforge\/project_setup:\$PATH["\047]?[[:space:]]*(#.*)?$/ { count++ }
            END { print count + 0 }
        ' "$bashrc_file")"
        legacy_count="$(awk -v managed_tag="$managed_tag" '
            index($0, managed_tag) { next }
            /^[[:space:]]*(export[[:space:]]+)?PATH=["\047]?[^:"\047]*\/hdlforge\/project_setup:\$PATH["\047]?[[:space:]]*(#.*)?$/ { count++ }
            END { print count + 0 }
        ' "$bashrc_file")"
        if [ "$unsupported_count" -ne 0 ]; then
            echo "[!x!] Error: found an unsupported HDLForge PATH expression in $bashrc_file" >&2
            return 1
        fi
        if [ "$marker_count" -eq 1 ] && [ "$matching_count" -eq 1 ] \
            && [ "$legacy_count" -eq 0 ]; then
            echo "[i] HDLForge PATH entry already correct: $bashrc_file"
            return 0
        fi
    else
        marker_count=0
    fi

    temporary_file="$(mktemp "${bashrc_file}.hdlforge.XXXXXX")" || return 1
    if [ "$marker_count" -eq 0 ]; then
        {
            [ ! -f "$bashrc_file" ] || cat "$bashrc_file"
            printf '\n%s\n' "$desired_line"
        } > "$temporary_file" || {
            rm -f "$temporary_file"
            return 1
        }
    else
        original_mode="$(stat -c '%a' "$bashrc_file")" || {
            rm -f "$temporary_file"
            return 1
        }
        awk -v desired_line="$desired_line" -v managed_tag="$managed_tag" '
            index($0, managed_tag) { next }
            /^[[:space:]]*(export[[:space:]]+)?PATH=["\047]?[^:"\047]*\/hdlforge\/project_setup:\$PATH["\047]?[[:space:]]*(#.*)?$/ { next }
            { print }
            END { print desired_line }
        ' "$bashrc_file" > "$temporary_file" || {
            rm -f "$temporary_file"
            return 1
        }
        chmod "$original_mode" "$temporary_file" || {
            rm -f "$temporary_file"
            return 1
        }
    fi
    mv "$temporary_file" "$bashrc_file" || {
        rm -f "$temporary_file"
        return 1
    }
    if [ "$marker_count" -eq 0 ]; then
        echo "[i] Added HDLForge PATH entry to $bashrc_file"
    else
        echo "[i] Repaired HDLForge PATH entry in $bashrc_file"
    fi
}

hdlforge_add_to_bashrc_completion() {
    local bashrc_file="${HOME:?HDLForge requires HOME}/.bashrc"
    local managed_tag="# hdlforge-completion"
    local desired_line="[ -r \"${HDLFORGE_INSTALL_DIR}/hdlforge_completion.bash\" ] && source \"${HDLFORGE_INSTALL_DIR}/hdlforge_completion.bash\" ${managed_tag}"
    local temporary_file
    local original_mode

    if [ -f "$bashrc_file" ] && grep -F -x -q "$desired_line" "$bashrc_file"; then
        echo "[i] HDLForge completion already correct: $bashrc_file"
        return 0
    fi
    temporary_file="$(mktemp "${bashrc_file}.hdlforge.XXXXXX")" || return 1
    [ ! -f "$bashrc_file" ] || original_mode="$(stat -c '%a' "$bashrc_file")" || return 1
    {
        [ ! -f "$bashrc_file" ] || awk -v managed_tag="$managed_tag" 'index($0, managed_tag) { next } { print }' "$bashrc_file"
        printf '%s\n' "$desired_line"
    } > "$temporary_file" || return 1
    [ -z "${original_mode:-}" ] || chmod "$original_mode" "$temporary_file" || return 1
    mv "$temporary_file" "$bashrc_file" || return 1
    echo "[i] Added HDLForge completion to $bashrc_file"
}

# Resolve the public command tree before touching project/tool environments.
# NUL records preserve shell payloads and option values without eval or splitting.
route_file="$(mktemp)" || exit 1
trap 'rm -f "$route_file"' EXIT
python3 "$HDLFORGE_INSTALL_DIR/hdlforge_command_tree.py" "$@" > "$route_file" || exit $?
mapfile -d '' -t routed < "$route_file"
rm -f "$route_file"
trap - EXIT
if [ "${routed[0]}" = HELP ]; then
    printf '%s\n' "${routed[1]}"
    exit 0
fi
master_count="${routed[1]}"
master_args=("${routed[@]:2:master_count}")
internal_args=("${routed[@]:2+master_count}")
HDLFORGE_ALLOW_ENV_OVERWRITE=0
route_args=()
set -- "${master_args[@]}"
while [ "$#" -gt 0 ]; do
    case "$1" in
        --allow-env-overwrite) HDLFORGE_ALLOW_ENV_OVERWRITE=1; shift ;;
        --dry-run) DRY_RUN=true; export HDLFORGE_DRY_RUN=1; shift ;;
        --no-print) shift ;; # Compatibility with existing repository launchers.
        *) route_args+=("$1" "$2"); shift 2 ;;
    esac
done
environment_args=("${route_args[@]}")
set -- "${route_args[@]}" "${internal_args[@]}"

# Project discovery selects configuration but never changes the launch directory.
# An explicit --project is the only operation that enters a project directory.
hdlforge_select_project "$@" || exit 1
set -- "${HDLFORGE_PROJECT_ARGS[@]}"
selected_args=("$@")
if [ "$HDLFORGE_EXPLICIT_PROJECT" = 1 ]; then
    cd "$PROJECT_DIR" || {
        echo "error: failed to enter explicit project directory: $PROJECT_DIR" >&2
        exit 1
    }
fi

# Explicit environment initialization must work before that environment exists.
# Reuse the atomic JSON updater; normal execution still requires valid settings.
if { [ "${internal_args[0]}" = --json-schema ] && [ "${internal_args[1]}" = paths ] && [ "${internal_args[2]}" = update-json ]; } ||
   { [ "${internal_args[0]}" = --tool ] && [ "${internal_args[1]}" = path_manager ] && [ "${internal_args[2]}" = update-repo ]; }; then
    update_project="$PROJECT_FILE_PATH"
    if [ "${internal_args[2]}" = update-repo ]; then
        update_repo_top="$(git rev-parse --show-toplevel)" || exit 1
        if [ "$HDLFORGE_EXPLICIT_PROJECT" != 1 ]; then
            update_project="$(REPO_TOP="$update_repo_top" hdlforge_find_repo_environment_project)" || exit 1
        fi
        if [ "$(dirname "$update_project")" != "$update_repo_top" ]; then
            echo "error: settings.update-repo requires a JSON directly at repository top: $update_repo_top" >&2
            exit 1
        fi
    fi
    [ -n "$update_project" ] || { echo "error: select a project JSON with --project" >&2; exit 1; }
    schema_args=(paths update-json --project "$update_project")
    [ "$DRY_RUN" != true ] || schema_args+=(--dry-run)
    exec python3 "$HDLFORGE_INSTALL_DIR/hdlforge_json.py" "${schema_args[@]}"
fi

# Every runnable command evaluates the repository JSON base environment first,
# then the selected project JSON overlay when it is a different file.
hdlforge_prepare_environment || exit 1
hdlforge_apply_env_state "${environment_args[@]}"

# JSON maintenance uses the same mandatory repository environment as all tools.
if [ "${internal_args[0]}" = --json-schema ]; then
    [ -n "$PROJECT_FILE_PATH" ] || { echo "error: select a project JSON with --project" >&2; exit 1; }
    schema_args=("${internal_args[@]:1}" --project "$PROJECT_FILE_PATH")
    [ "$DRY_RUN" != true ] || schema_args+=(--dry-run)
    exec python3 "$HDLFORGE_INSTALL_DIR/hdlforge_json.py" "${schema_args[@]}"
fi

# Extract the tool anchor without interpreting values as independent actions.
management_tool=""
management_args=()
management_input=("$@")
for ((management_index=0; management_index<${#management_input[@]}; management_index++)); do
    management_arg="${management_input[management_index]}"
    case "$management_arg" in
        --tool)
            management_index=$((management_index + 1))
            management_tool="${management_input[management_index]}"
            ;;
        --tool=*) management_tool="${management_arg#*=}" ;;
        --) break ;;
        --cmd|--cmd-argv|--eval_json)
            management_args+=("${management_input[@]:management_index}")
            break
            ;;
        --project|--env-path|--env-python|--env-var|--flags)
            management_args+=("$management_arg")
            management_index=$((management_index + 1))
            management_args+=("${management_input[management_index]}")
            ;;
        --no-print) ;;
        --dry-run) DRY_RUN=true; management_args+=("$management_arg") ;;
        --allow-env-overwrite) ;;
        *) management_args+=("$management_arg") ;;
    esac
done
if [ "$management_tool" = env_settings ]; then
    settings_args=("${internal_args[@]:2}")
    [ "$DRY_RUN" != true ] || settings_args+=(--dry-run)
    exec python3 "$HDLFORGE_INSTALL_DIR/env_settings.py" "${settings_args[@]}" \
        --repository "$HDLFORGE_ENV_REPO_JSON" --active-server "$HDLFORGE_SELECTED_HOST" \
        --active-user "$HDLFORGE_SELECTED_USER" --launch-dir "$HDLFORGE_LAUNCH_DIR"
fi
if [ "$management_tool" = git_config ]; then
    git_config_args=("${internal_args[@]:2}")
    [ "$DRY_RUN" != true ] || git_config_args+=(--dry-run)
    exec python3 "$HDLFORGE_INSTALL_DIR/git_config_cli.py" "${git_config_args[@]}"
fi
if [ "$management_tool" = path_manager ]; then
    if [ "$DRY_RUN" = true ]; then
        printf '[i] path_manager command resolved; execution skipped\n'
        exit 0
    fi
    management_action=""
    update_project=""
    set -- "${management_args[@]}"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --env-path|--env-python|--env-var) shift ;;
            --project) update_project="$2"; shift ;;
            --project=*) update_project="${1#*=}" ;;
            --help|-h)
                echo 'usage: hdlforge settings.help [--project FILE]'
                exit 0 ;;
            *)
                if [ -n "$management_action" ] || [[ "$1" == -* ]]; then
                    echo "error: unexpected path_manager argument: $1" >&2
                    exit 2
                fi
                management_action="$1" ;;
        esac
        shift
    done
    case "$management_action" in
        init-base-path) printf 'export HDLFORGE_BASE_PATH=%q\n' "$PATH"; exit 0 ;;
        init-base-pythonpath) printf 'export HDLFORGE_BASE_PYTHONPATH=%q\n' "${PYTHONPATH:-}"; exit 0 ;;
        install-shell) hdlforge_add_to_bashrc_path && hdlforge_add_to_bashrc_completion; exit $? ;;
        show|show-all)
            set -- --tool path_manager "$management_action"
            [ -z "$update_project" ] || set -- "$@" --project "$update_project"
            ;;
        *) echo 'error: select a paths action; use --help' >&2; exit 2 ;;
    esac
fi

if [ -z "$REPO_TOP" ]; then
    echo "❌ Not inside a Git repository. Please run hdlforge from within a Git repository."
    exit 1
fi

# Use FABRINETES to find tasks directory (already validated at script start)
TASKS_DIR="$FABRINETES/hdlforge/project_setup"
SCRIPT_PATH="$TASKS_DIR/hdlforge"
shell_id="$PPID"
timestamp=$(date +%Y%m%d)
time=$(date +%H%M%S)

# Selection normalized invocation-relative native file paths. Environment
# options remain removable by arity without touching opaque payload values.
set -- "${selected_args[@]}"
filtered_native=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --env-python|--env-path|--env-var) shift 2 ;;
        *) filtered_native+=("$@"); break ;;
    esac
done
set -- "${filtered_native[@]}"

if [ "$management_tool" = path_manager ] && [ "$management_action" = show ]; then
    hdlforge_print_environment
    exit 0
fi

if [ "$management_tool" = path_manager ] && [ "$management_action" = show-all ]; then
    hdlforge_print_all_host_and_user_environments
    exit 0
fi

mkdir -p "$TASKS_DIR/logs"
log_file="$TASKS_DIR/logs/hdlforge_${timestamp}_pid${shell_id}.log"

# Execute only explicit evaluation commands or project-shortcut leaves.
command_mode=""
command_value=""
command_values=()
native_args=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --eval_json)
            command_mode="$1"
            command_value="$2"
            alias_args=("${@:3}")
            break
            ;;
        --cmd|--cmd-argv)
            command_mode="$1"
            command_values=("${@:2}")
            break
            ;;
        --tool)
            native_args=("$@")
            break
            ;;
        *) echo "error: unexpected internal argument: $1" >&2; exit 2 ;;
    esac
done
if [ -n "$command_mode" ]; then
    if [ "$command_mode" = --eval_json ]; then
        export HDLFORGE_JSON_COMMAND_PATH="$command_value"
        command_value="$("$HDLFORGE_JQ" -er --arg path "$command_value" 'getpath($path | split(".")) | select(type == "string" and length > 0)' < "$PROJECT_FILE_PATH")" || exit 1
        # Only the authored shortcut is shell code; caller arguments stay literal.
        if [ "${#alias_args[@]}" -gt 0 ]; then
            command_value+=" $(hdlforge_shell_quote_args "${alias_args[@]}")"
        fi
        command_values=("$command_value")
    fi
    if [ "$command_mode" = --cmd-argv ]; then
        printf -v COMMAND '%q ' "${command_values[@]}"
        COMMAND="${COMMAND% }"
    else
        COMMAND="${command_values[*]}"
    fi
    if [ "$DRY_RUN" = true ]; then
        printf '[i] Working directory: %s\n[i] Command: %s\n[i] execution skipped\n' "$PWD" "$COMMAND"
        exit 0
    fi
    [[ ! -v HDLFORGE_DEBUG ]] || printf '[i] Executing: %s\n' "$COMMAND"
    export HDLFORGE_PROJECT_FILE="$PROJECT_FILE_PATH"
    if [ "$command_mode" = --cmd-argv ]; then
        exec "${command_values[@]}"
    else
        set +o braceexpand
        eval "${command_values[@]}"
    fi
    exit $?
fi
set -- "${native_args[@]}"

echo "--------$(pwd): $Date: $timestamp Time $time------" >> "$log_file"

# Native tools receive the same absolute project selected during startup.
if [ -n "$PROJECT_FILE_PATH" ]; then
    set -- --project "$PROJECT_FILE_PATH" "$@"
fi

if [ "$DRY_RUN" = true ]; then
    # Cleanup has a read-only preview that lists actual artifact candidates.
    # The Python dispatcher validates the complete argument combination.
    for hdlforge_preview_arg in "$@"; do
        if [[ "$hdlforge_preview_arg" == "--build_clean_ignore_artifacts" || "$hdlforge_preview_arg" == "--clean_ignore_artifacts" ]]; then
            exec python3 "$TASKS_DIR/tasks.py" "$@" --dry-run
        fi
    done
    echo "[i] HDLForge dry-run: final --tool command resolved"
    echo "[i] Working directory: $(pwd)"
    echo "[i] Command: $(hdlforge_shell_quote_args python3 "$TASKS_DIR/tasks.py" "$@")"
    echo "[i] --tool execution skipped"
    exit 0
fi

# Execute the command
# Interactive follow must retain the terminal for redraw and clean Ctrl-C.
# A tee pipe hides isatty() and can close before Python prints its stop message.
hdlforge_follow_terminal=false
hdlforge_previous_arg=""
for hdlforge_follow_arg in "$@"; do
    if [[ "$hdlforge_previous_arg" == "--project_console" && "$hdlforge_follow_arg" == "follow" ]]; then
        hdlforge_follow_terminal=true
    fi
    hdlforge_previous_arg="$hdlforge_follow_arg"
done
if [[ "$hdlforge_follow_terminal" == true && -t 1 ]]; then
    exec python3 "$TASKS_DIR/tasks.py" "$@"
fi

exec python3 "$TASKS_DIR/tasks.py" "$@" | tee -a "$log_file"

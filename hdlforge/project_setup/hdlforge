#!/bin/bash

set -o pipefail

# =============================================================================
# FABRINETES must be set - it points to the Fabrinetes repository root
# =============================================================================
if [ -z "$FABRINETES" ]; then
    echo "❌ FABRINETES environment variable is not set."
    echo ""
    echo "Please set FABRINETES to point to the Fabrinetes repository root:"
    echo "  export FABRINETES=/path/to/Fabrinetes"
    echo ""
    echo "Add this to your ~/.bashrc or shell profile for persistence."
    exit 1
fi

if [ ! -d "$FABRINETES/hdlforge/project_setup" ]; then
    echo "❌ Invalid FABRINETES path: $FABRINETES"
    echo "   Directory not found: $FABRINETES/hdlforge/project_setup"
    exit 1
fi
# =============================================================================

if [ "${HDLFORGE_ENV_STATE_ACTIVE:-0}" != "1" ]; then
    unset HDLFORGE_ADD_PYTHONPATH
    unset HDLFORGE_ADD_PATH
    unset HDLFORGE_ADD_ENV_JSON
    unset HDLFORGE_ADD_ENV_VAR_JSON
fi

HDLFORGE_ENV_PYTHON_JSONS=()
HDLFORGE_ENV_PATH_JSONS=()
HDLFORGE_ENV_VAR_JSONS=()
HDLFORGE_COLLECTED_PYTHONPATHS=()
HDLFORGE_COLLECTED_PATHS=()
HDLFORGE_COLLECTED_ENV_KEYS=()
HDLFORGE_COLLECTED_ENV_VALUES=()
CURRENT_EVAL_JSON_MODE=false
DRY_RUN=false
if [[ -n "${HDLFORGE_DRY_RUN:-}" && "${HDLFORGE_DRY_RUN:-0}" != "0" ]]; then
    DRY_RUN=true
    export HDLFORGE_DRY_RUN=1
fi

hdlforge_warn() {
    if [ "$CURRENT_EVAL_JSON_MODE" != true ] && [ "${NO_PRINT:-false}" != true ]; then
        echo "$@"
    fi
}

hdlforge_shell_quote_args() {
    local arg
    local quoted_arg
    local command_text=""

    for arg in "$@"; do
        printf -v quoted_arg '%q' "$arg"
        if [ -z "$command_text" ]; then
            command_text="$quoted_arg"
        else
            command_text="${command_text} ${quoted_arg}"
        fi
    done

    printf '%s' "$command_text"
}

hdlforge_print_usage() {
    echo "Usage: hdlforge [--project <project_file>] [--env-python <array-leaf-or-json> | --env-path <array-leaf-or-json> | --env-var <array-leaf-or-json>] [--dry-run] [--no-print] --tool <tool_name> [--arg value --arg value...]"
    echo "   or: hdlforge [--project <project_file>] [--env-python <array-leaf-or-json> | --env-path <array-leaf-or-json> | --env-var <array-leaf-or-json>] [--dry-run] [--no-print] <llm_orch.dotted.path> [--append <fragment>]"
    echo "   or: hdlforge [--project <project_file>] [--env-python <array-leaf-or-json> | --env-path <array-leaf-or-json> | --env-var <array-leaf-or-json>] [--dry-run] [--no-print] --cmd <shell-command> [--append <fragment>]"
    echo ""
    echo "Examples:"
    echo "  hdlforge testing.integration_test.sim.base.run"
    echo "  hdlforge --eval_json LLM_orch.testing.integration_test.sim.base.run"
    echo "  hdlforge --cmd 'python3 -c \"print(42)\"'"
    echo "  hdlforge --no-print --cmd 'python3 -c \"print(42)\"'"
}

hdlforge_append_unique() {
    local array_name="$1"
    local value="$2"
    local label="${3:-HDLForge env path}"
    local -n target_array="$array_name"

    [ -n "$value" ] || return 0
    for existing in "${target_array[@]}"; do
        if [ "$existing" = "$value" ]; then
            hdlforge_warn "[!] HDLForge env duplicate $label ignored: $value"
            return 1
        fi
    done
    target_array+=("$value")
    return 0
}

hdlforge_join_colon() {
    local joined=""
    local value
    for value in "$@"; do
        [ -n "$value" ] || continue
        if [ -z "$joined" ]; then
            joined="$value"
        else
            joined="${joined}:$value"
        fi
    done
    printf '%s' "$joined"
}

hdlforge_resolve_project_path() {
    local raw_path="$1"

    raw_path="${raw_path/#\~/$HOME}"
    if [[ "$raw_path" == /* ]]; then
        realpath -m "$raw_path"
    else
        realpath -m "$ROOT_FOLDER/$raw_path"
    fi
}

hdlforge_collect_colon_paths() {
    local value="$1"
    local array_name="$2"
    local label="${3:-HDLForge env path}"
    local path_value
    local old_ifs="$IFS"

    IFS=':'
    for path_value in $value; do
        hdlforge_append_unique "$array_name" "$path_value" "$label"
    done
    IFS="$old_ifs"
}

hdlforge_path_contains() {
    local path_list="$1"
    local path_to_find="$2"
    local path_value
    local old_ifs="$IFS"

    IFS=':'
    for path_value in $path_list; do
        if [ "$path_value" = "$path_to_find" ]; then
            IFS="$old_ifs"
            return 0
        fi
    done
    IFS="$old_ifs"
    return 1
}

hdlforge_clean_env_json() {
    local json_text="$1"
    local source_label="${2:-HDLForge env JSON}"
    local clean_json

    if ! clean_json="$(printf '%s' "$json_text" | jq -c '.')"; then
        echo "[!x!] $source_label is not valid JSON" >&2
        echo "[i] Pass a selected-project JSON leaf or clean raw JSON" >&2
        return 1
    fi

    printf '%s' "$clean_json"
}

hdlforge_find_project_json() {
    local candidates=()

    if [ -n "${PROJECT_FILE_PATH:-}" ] && [[ "$PROJECT_FILE_PATH" == *.hdlforge.json ]] && [ -f "$PROJECT_FILE_PATH" ]; then
        realpath "$PROJECT_FILE_PATH"
        return 0
    fi

    if [ -z "${ROOT_FOLDER:-}" ] || [ ! -d "$ROOT_FOLDER" ]; then
        echo "[!x!] Cannot resolve HDLForge project JSON: ROOT_FOLDER is not set" >&2
        return 1
    fi

    shopt -s nullglob
    candidates=("$ROOT_FOLDER"/*.hdlforge.json)
    shopt -u nullglob

    if [ ${#candidates[@]} -eq 1 ]; then
        realpath "${candidates[0]}"
        return 0
    fi

    if [ ${#candidates[@]} -gt 1 ]; then
        echo "[!x!] Cannot resolve HDLForge project JSON: multiple *.hdlforge.json files under $ROOT_FOLDER" >&2
        echo "[i] Use --project <project_file> for env leaf resolution" >&2
        return 1
    fi

    echo "[!x!] Cannot resolve HDLForge project JSON under $ROOT_FOLDER" >&2
    return 1
}

hdlforge_resolve_env_json_arg() {
    local json_text="$1"
    local expected_type="$2"
    local source_label="${3:-HDLForge env JSON}"
    local clean_json
    local project_json
    local json_path
    local leaf_json
    local raw_json_was_valid=false

    json_path="${json_text#.}"
    project_json="$(hdlforge_find_project_json 2>/dev/null || true)"
    if [ -n "$json_path" ] && [ -n "$project_json" ]; then
        leaf_json="$(jq -c --arg json_path "$json_path" 'getpath($json_path | split("."))' "$project_json" 2>/dev/null || true)"
        if [ -n "$leaf_json" ] && [ "$leaf_json" != "null" ]; then
            if printf '%s' "$leaf_json" | jq -e --arg expected_type "$expected_type" 'type == $expected_type' >/dev/null 2>&1; then
                printf '%s' "$leaf_json"
                return 0
            fi
            echo "[!x!] $source_label project leaf validation failed: $json_path" >&2
            echo "[i] Expected JSON type: $expected_type" >&2
            return 1
        fi
    fi

    if clean_json="$(printf '%s' "$json_text" | jq -c '.' 2>/dev/null)"; then
        raw_json_was_valid=true
        if printf '%s' "$clean_json" | jq -e --arg expected_type "$expected_type" 'type == $expected_type' >/dev/null 2>&1; then
            printf '%s' "$clean_json"
            return 0
        fi
    fi

    if [ "$raw_json_was_valid" = true ]; then
        echo "[!x!] $source_label validation failed" >&2
        echo "[i] Raw JSON was valid, but expected JSON type: $expected_type" >&2
        return 1
    fi

    echo "[!x!] $source_label is neither raw JSON nor a project JSON leaf: $json_text" >&2
    echo "[i] Use a project leaf like verilator.config.sim_targets.full_sim.env.pythonpath" >&2
    echo "[i] Or pass raw JSON such as [\"sources/tests\"]" >&2
    return 1
}

hdlforge_validate_env_key() {
    local key="$1"
    if [[ ! "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        echo "[!x!] Invalid HDLForge env key: $key"
        echo "[i] Env keys must match [A-Za-z_][A-Za-z0-9_]*"
        return 1
    fi
    return 0
}

hdlforge_collect_env_pair() {
    local key="$1"
    local value="$2"
    local index

    hdlforge_validate_env_key "$key" || return 1

    for index in "${!HDLFORGE_COLLECTED_ENV_KEYS[@]}"; do
        if [ "${HDLFORGE_COLLECTED_ENV_KEYS[$index]}" = "$key" ]; then
            if [ "${HDLFORGE_COLLECTED_ENV_VALUES[$index]}" = "$value" ]; then
                hdlforge_warn "[!] HDLForge env duplicate key ignored: $key"
                return 0
            fi
            hdlforge_warn "[!] HDLForge env override: $key"
            HDLFORGE_COLLECTED_ENV_VALUES[$index]="$value"
            return 0
        fi
    done

    HDLFORGE_COLLECTED_ENV_KEYS+=("$key")
    HDLFORGE_COLLECTED_ENV_VALUES+=("$value")
}

hdlforge_collect_env_var_json() {
    local json_text="$1"
    local source_label="${2:-HDLForge env var JSON array}"
    local clean_json
    local entry
    local key
    local value

    [ -n "$json_text" ] || return 0
    clean_json="$(hdlforge_resolve_env_json_arg "$json_text" "array" "$source_label")" || return 1

    if ! printf '%s' "$clean_json" | jq -e '
        type == "array"
        and all(.[]; type == "object" and length == 1)
    ' >/dev/null 2>&1; then
        echo "[!x!] $source_label validation failed" >&2
        echo "[i] Expected a JSON array of single-key objects, e.g. [{\"FOO\":\"bar\"}]" >&2
        return 1
    fi

    while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        key="$(printf '%s' "$entry" | jq -r 'keys[0]')"
        value="$(printf '%s' "$entry" | jq -r '.[keys[0]] | tostring')"
        hdlforge_collect_env_pair "$key" "$value" || return 1
    done < <(printf '%s' "$clean_json" | jq -c '.[]')
}

hdlforge_collect_path_array_json() {
    local json_text="$1"
    local array_name="$2"
    local label="$3"
    local source_label="${4:-HDLForge env path JSON array}"
    local clean_json
    local path_value
    local resolved_path

    [ -n "$json_text" ] || return 0
    clean_json="$(hdlforge_resolve_env_json_arg "$json_text" "array" "$source_label")" || return 1

    if ! printf '%s' "$clean_json" | jq -e '
        type == "array"
        and all(.[]; type == "string")
    ' >/dev/null 2>&1; then
        echo "[!x!] $source_label validation failed" >&2
        echo "[i] Expected a JSON array of strings, e.g. [\"sources/tests\"]" >&2
        return 1
    fi

    while IFS= read -r path_value; do
        [ -n "$path_value" ] || continue
        resolved_path="$(hdlforge_resolve_project_path "$path_value")"
        if [ ! -e "$resolved_path" ]; then
            echo "[!x!] HDLForge $label path does not exist: $resolved_path" >&2
            echo "[i] Relative $label paths are resolved from project folder: $ROOT_FOLDER" >&2
            return 1
        fi
        hdlforge_append_unique "$array_name" "$resolved_path" "$label"
    done < <(printf '%s' "$clean_json" | jq -r '.[]')
}

hdlforge_parse_env_args() {
    local args_filtered=()
    local arg
    local expect_value=""
    local seen_dd=false

    for arg in "$@"; do
        if [ "$seen_dd" = true ]; then
            args_filtered+=("$arg")
            continue
        fi

        if [ -n "$expect_value" ]; then
            case "$expect_value" in
                --env-python) HDLFORGE_ENV_PYTHON_JSONS+=("$arg") ;;
                --env-path) HDLFORGE_ENV_PATH_JSONS+=("$arg") ;;
                --env-var) HDLFORGE_ENV_VAR_JSONS+=("$arg") ;;
            esac
            expect_value=""
            continue
        fi

        case "$arg" in
            --)
                seen_dd=true
                args_filtered+=("$arg")
                ;;
            --env-python|--env-path|--env-var)
                expect_value="$arg"
                ;;
            --env-python-json)
                echo "[!x!] --env-python-json was removed"
                echo "[i] Use --env-python <pythonpath.array.leaf-or-raw-json>"
                exit 1
                ;;
            --env-path-json)
                echo "[!x!] --env-path-json was removed"
                echo "[i] Use --env-path <path.array.leaf-or-raw-json>"
                exit 1
                ;;
            --env-var-json)
                echo "[!x!] --env-var-json was removed"
                echo "[i] Use --env-var <env.array.leaf-or-raw-json>"
                exit 1
                ;;
            --env-file|--env-str|--env-json)
                echo "[!x!] $arg was removed"
                echo "[i] Use --env-python <pythonpath.array.leaf-or-raw-json>"
                echo "[i] Or:  --env-path <path.array.leaf-or-raw-json>"
                echo "[i] Or:  --env-var <env.array.leaf-or-raw-json>"
                exit 1
                ;;
            --env-json-file)
                echo "[!x!] --env-json-file was removed"
                echo "[i] Use --env-python, --env-path, or --env-var with a project leaf or raw JSON string"
                exit 1
                ;;
            --env-json-str)
                echo "[!x!] --env-json-str was removed"
                echo "[i] Use --env-python, --env-path, or --env-var with a project leaf or raw JSON string"
                exit 1
                ;;
            *)
                args_filtered+=("$arg")
                ;;
        esac
    done

    if [ -n "$expect_value" ]; then
        echo "[!x!] $expect_value requires a value"
        exit 1
    fi

    set -- "${args_filtered[@]}"
    HDLFORGE_FILTERED_ARGS=("$@")
}

hdlforge_apply_env_state() {
    local json_arg
    local path_arg
    local env_key
    local env_value
    local index
    local carry_env_var_json
    local has_env_state=false

    hdlforge_parse_env_args "$@"

    if [ ${#HDLFORGE_ENV_PYTHON_JSONS[@]} -gt 0 ] \
        || [ ${#HDLFORGE_ENV_PATH_JSONS[@]} -gt 0 ] \
        || [ ${#HDLFORGE_ENV_VAR_JSONS[@]} -gt 0 ] \
        || [ -n "${HDLFORGE_ADD_ENV_VAR_JSON:-}" ]; then
        if ! command -v jq >/dev/null 2>&1; then
            echo "[!x!] jq is required for HDLForge env handling"
            exit 1
        fi
    fi

    if [ "${HDLFORGE_ENV_STATE_ACTIVE:-0}" = "1" ]; then
        hdlforge_collect_colon_paths "${HDLFORGE_ADD_PYTHONPATH:-}" HDLFORGE_COLLECTED_PYTHONPATHS "PYTHONPATH"
        hdlforge_collect_colon_paths "${HDLFORGE_ADD_PATH:-}" HDLFORGE_COLLECTED_PATHS "PATH"
        if [ -n "${HDLFORGE_ADD_ENV_VAR_JSON:-}" ]; then
            hdlforge_collect_env_var_json "$HDLFORGE_ADD_ENV_VAR_JSON" "HDLForge inherited env var JSON" || exit 1
        fi
    fi

    for json_arg in "${HDLFORGE_ENV_PYTHON_JSONS[@]}"; do
        hdlforge_collect_path_array_json \
            "$json_arg" \
            HDLFORGE_COLLECTED_PYTHONPATHS \
            "PYTHONPATH" \
            "HDLForge --env-python array" || exit 1
    done

    for json_arg in "${HDLFORGE_ENV_PATH_JSONS[@]}"; do
        hdlforge_collect_path_array_json \
            "$json_arg" \
            HDLFORGE_COLLECTED_PATHS \
            "PATH" \
            "HDLForge --env-path array" || exit 1
    done

    for json_arg in "${HDLFORGE_ENV_VAR_JSONS[@]}"; do
        hdlforge_collect_env_var_json "$json_arg" "HDLForge --env-var array" || exit 1
    done

    for path_arg in "${HDLFORGE_COLLECTED_PYTHONPATHS[@]}"; do
        if hdlforge_path_contains "${PYTHONPATH:-}" "$path_arg"; then
            hdlforge_warn "[!] HDLForge env duplicate PYTHONPATH already present: $path_arg"
        fi
        add_to_pythonpath "$path_arg"
        has_env_state=true
    done

    for path_arg in "${HDLFORGE_COLLECTED_PATHS[@]}"; do
        if hdlforge_path_contains "$PATH" "$path_arg"; then
            hdlforge_warn "[!] HDLForge env duplicate PATH already present: $path_arg"
        fi
        add_to_path "$path_arg"
        has_env_state=true
    done

    for index in "${!HDLFORGE_COLLECTED_ENV_KEYS[@]}"; do
        env_key="${HDLFORGE_COLLECTED_ENV_KEYS[$index]}"
        env_value="${HDLFORGE_COLLECTED_ENV_VALUES[$index]}"
        export "$env_key=$env_value"
        has_env_state=true
    done

    if command -v remove_duplicates_from_path >/dev/null 2>&1; then
        if [ -n "$PATH" ]; then
            export PATH="$(remove_duplicates_from_path "$PATH")"
        fi
        if [ -n "$PYTHONPATH" ]; then
            export PYTHONPATH="$(remove_duplicates_from_path "$PYTHONPATH")"
        fi
    fi

    if [ "$has_env_state" = true ]; then
        export HDLFORGE_ENV_STATE_ACTIVE=1
        export HDLFORGE_ADD_PYTHONPATH="$(hdlforge_join_colon "${HDLFORGE_COLLECTED_PYTHONPATHS[@]}")"
        export HDLFORGE_ADD_PATH="$(hdlforge_join_colon "${HDLFORGE_COLLECTED_PATHS[@]}")"
        if [ ${#HDLFORGE_COLLECTED_ENV_KEYS[@]} -gt 0 ]; then
            carry_env_var_json="$(jq -cn '[]')"
            for index in "${!HDLFORGE_COLLECTED_ENV_KEYS[@]}"; do
                env_key="${HDLFORGE_COLLECTED_ENV_KEYS[$index]}"
                env_value="${HDLFORGE_COLLECTED_ENV_VALUES[$index]}"
                carry_env_var_json="$(
                    jq -cn \
                        --argjson base "$carry_env_var_json" \
                        --arg key "$env_key" \
                        --arg value "$env_value" \
                        '$base + [{($key): $value}]'
                )"
            done
            export HDLFORGE_ADD_ENV_VAR_JSON="$carry_env_var_json"
        else
            unset HDLFORGE_ADD_ENV_VAR_JSON
        fi
        unset HDLFORGE_ADD_ENV_JSON
    else
        unset HDLFORGE_ENV_STATE_ACTIVE
        unset HDLFORGE_ADD_PYTHONPATH
        unset HDLFORGE_ADD_PATH
        unset HDLFORGE_ADD_ENV_JSON
        unset HDLFORGE_ADD_ENV_VAR_JSON
    fi

    set -- "${HDLFORGE_FILTERED_ARGS[@]}"
    HDLFORGE_FILTERED_ARGS=("$@")
}

hdlforge_inject_default_eval_json() {
    local has_tool=false
    local has_eval_json=false
    local has_raw_cmd=false
    local expect_value=""
    local seen_dd=false
    local non_flag_count=0
    local non_flag_value=""
    local eval_json_path=""
    local arg
    local injected=false
    local new_args=()

    for arg in "$@"; do
        if [ "$seen_dd" = true ]; then
            continue
        fi

        if [ -n "$expect_value" ]; then
            expect_value=""
            continue
        fi

        case "$arg" in
            --)
                seen_dd=true
                ;;
            --tool)
                has_tool=true
                expect_value="$arg"
                ;;
            --eval_json)
                has_eval_json=true
                expect_value="$arg"
                ;;
            --cmd)
                has_raw_cmd=true
                expect_value="$arg"
                ;;
            --project|--env-python|--env-path|--env-var|--append|--eval_json_append)
                expect_value="$arg"
                ;;
            -*)
                ;;
            *)
                non_flag_count=$((non_flag_count + 1))
                non_flag_value="$arg"
                ;;
        esac
    done

    if [ -n "$expect_value" ]; then
        echo "[!x!] Error: $expect_value requires VALUE"
        hdlforge_print_usage
        return 1
    fi

    if [ "$has_eval_json" = true ] && [ "$non_flag_count" -gt 0 ]; then
        echo "[!x!] Error: explicit --eval_json cannot be combined with shorthand shortcut path: $non_flag_value"
        hdlforge_print_usage
        return 1
    fi

    if [ "$has_tool" = true ] || [ "$has_eval_json" = true ] || [ "$has_raw_cmd" = true ] || [ "$non_flag_count" -ne 1 ]; then
        HDLFORGE_DEFAULT_EVAL_JSON_ARGS=("$@")
        return 0
    fi

    expect_value=""
    seen_dd=false
    for arg in "$@"; do
        if [ "$seen_dd" = true ]; then
            new_args+=("$arg")
            continue
        fi

        if [ -n "$expect_value" ]; then
            new_args+=("$arg")
            expect_value=""
            continue
        fi

        case "$arg" in
            --)
                seen_dd=true
                new_args+=("$arg")
                ;;
            --tool|--eval_json|--cmd|--project|--env-python|--env-path|--env-var|--append|--eval_json_append)
                new_args+=("$arg")
                expect_value="$arg"
                ;;
            *)
                if [ "$injected" = false ] && [ "$arg" = "$non_flag_value" ]; then
                    if [[ "$arg" == LLM_orch.* ]]; then
                        eval_json_path="$arg"
                    else
                        eval_json_path="LLM_orch.${arg}"
                    fi
                    new_args+=("--eval_json" "$eval_json_path")
                    injected=true
                else
                    new_args+=("$arg")
                fi
                ;;
        esac
    done

    HDLFORGE_DEFAULT_EVAL_JSON_ARGS=("${new_args[@]}")
}

# Check if any arguments are provided
if [ $# -lt 1 ]; then
    # Look for existing project files in current directory (JSON first, then TOML)
    hdlforge_json_files=$(ls *.hdlforge.json 2>/dev/null)
    hdlforge_toml_files=$(ls *.hdlforge.toml 2>/dev/null)
    hdlforge_files="$hdlforge_json_files"$'\n'"$hdlforge_toml_files"
    hdlforge_files=$(echo "$hdlforge_files" | grep -v '^$' | head -1)
    
    if [ -n "$hdlforge_files" ] && [ $(echo "$hdlforge_files" | wc -l) -eq 1 ]; then
        # Exactly one file found - use it in the example
        example_file=$(echo "$hdlforge_files" | head -1)
        hdlforge_print_usage
        echo ""
        echo "Available Tools:"
        echo "  vivado        - FPGA Development Tasks (synthesis, implementation, bitstream)"
        echo "  Verilator     - Simulation Tasks (build, sim, lint)"
        echo "  network       - Network Utilities (raw packet sending)"
        echo "  vcd_analyzer  - VCD Waveform Analysis"
        echo "  tsharkWrapper - tshark Command Wrapper"
        echo "  hw_server     - Interactive FPGA Tools (program, ILA/VIO, JTAG)"
        echo "  projects      - Project Management"
        echo ""
        echo "hdlforge auto-detected project file in the current directory: $example_file"
    else
        hdlforge_print_usage
        echo ""
        echo "Available Tools:"
        echo "  vivado        - FPGA Development Tasks (synthesis, implementation, bitstream)"
        echo "  Verilator     - Simulation Tasks (build, sim, lint)"
        echo "  network       - Network Utilities (raw packet sending)"
        echo "  vcd_analyzer  - VCD Waveform Analysis"
        echo "  tsharkWrapper - tshark Command Wrapper"
        echo "  hw_server     - Interactive FPGA Tools (program, ILA/VIO, JTAG)"
        echo "  projects      - Project Management"
        echo ""
        echo "Note: --project is optional. If omitted, hdlforge will auto-detect *.hdlforge.json or *.hdlforge.toml files in the current directory."
    fi
    exit 1
fi

if [ $# -eq 1 ] && ([[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]); then
    hdlforge_print_usage
    echo ""
    echo "Available Tools:"
    echo "  vivado        - FPGA Development Tasks (synthesis, implementation, bitstream)"
    echo "  Verilator     - Simulation Tasks (build, sim, lint)"
    echo "  network       - Network Utilities (raw packet sending)"
    echo "  vcd_analyzer  - VCD Waveform Analysis"
    echo "  tsharkWrapper - tshark Command Wrapper"
    echo "  hw_server     - Interactive FPGA Tools (program, ILA/VIO, JTAG)"
    echo "  projects      - Project Management"
    exit 0
fi

# Check if command requires --project argument
if [[ "$1" == "help" || "$1" == "projects" ]]; then
    # Commands that don't need --project parameter
    PROJECT_FILE=""
    PROJECT_FILE_PATH=""
    PROJECT_DIR=""
    PROJECT_FILENAME=""
else
    # Commands that need --project parameter
    # Extract project file from --project argument
    PROJECT_FILE=""
    PROJECT_FILE_PATH=""
    PROJECT_DIR=""
    PROJECT_FILENAME=""
    
    # Parse arguments to find --project
    args=("$@")
    for i in "${!args[@]}"; do
        if [[ "${args[i]}" == "--project" && $((i+1)) -lt ${#args[@]} ]]; then
            PROJECT_FILE="${args[i+1]}"
            break
        fi
    done
    
    # Note: --project is now optional; Python layer will handle auto-detection
    
    # Only process project file if it was provided
    if [ -n "$PROJECT_FILE" ]; then
        # Resolve project file path (handle both relative and absolute paths)
        if [[ "$PROJECT_FILE" == /* ]]; then
            # Absolute path
            PROJECT_FILE_PATH="$PROJECT_FILE"
        else
            # Relative path - resolve relative to current directory
            PROJECT_FILE_PATH="$(realpath "$PROJECT_FILE")"
        fi
        
        # Check if project file exists
        if [ ! -f "$PROJECT_FILE_PATH" ]; then
            echo "❌ Project file not found: $PROJECT_FILE_PATH"
            exit 1
        fi
        
        # Get the directory containing the project file
        PROJECT_DIR="$(dirname "$PROJECT_FILE_PATH")"
        PROJECT_FILENAME="$(basename "$PROJECT_FILE_PATH")"
    else
        # No project file specified - will be auto-detected by Python
        # Set PROJECT_DIR to current directory
        PROJECT_DIR="$(pwd)"
        PROJECT_FILENAME=""
    fi
fi

# Normalize external project invocations so they behave exactly like:
#   cd <project-dir> && hdlforge --project <project-file> ...
# This keeps project-root-relative behavior stable even when launched elsewhere.
if [ -n "$PROJECT_FILE_PATH" ] && [ -n "$PROJECT_DIR" ] && [ -n "$PROJECT_FILENAME" ] && [ "${HDLFORGE_PROJECT_DIR_NORMALIZED:-0}" != "1" ]; then
    CURRENT_DIR="$(pwd -P)"
    PROJECT_DIR_REAL="$(cd "$PROJECT_DIR" && pwd -P)"

    if [ "$CURRENT_DIR" != "$PROJECT_DIR_REAL" ]; then
        normalized_args=()
        skip_next=false

        for arg in "$@"; do
            if [ "$skip_next" = true ]; then
                skip_next=false
                continue
            fi

            if [[ "$arg" == "--project" ]]; then
                skip_next=true
                normalized_args+=("--project" "$PROJECT_FILENAME")
            else
                normalized_args+=("$arg")
            fi
        done

        cd "$PROJECT_DIR_REAL" || {
            echo "❌ Failed to cd into project directory: $PROJECT_DIR_REAL"
            exit 1
        }

        exec env HDLFORGE_PROJECT_DIR_NORMALIZED=1 "$0" "${normalized_args[@]}"
    fi
fi

# Resolve --vcdfilename path to absolute BEFORE changing directories
# This ensures relative paths work from the invocation location
ORIG_DIR="$(pwd)"
args_resolved=()
skip_next=false
for i in $(seq 1 $#); do
    if [ "$skip_next" = true ]; then
        skip_next=false
        continue
    fi
    arg="${!i}"
    next_i=$((i + 1))
    if [[ "$arg" == "--vcdfilename" && $next_i -le $# ]]; then
        vcd_arg="${!next_i}"
        skip_next=true
        # Resolve to absolute path if relative
        if [[ "$vcd_arg" != /* ]]; then
            vcd_arg="$(cd "$ORIG_DIR" && realpath "$vcd_arg" 2>/dev/null || echo "$ORIG_DIR/$vcd_arg")"
        fi
        args_resolved+=("--vcdfilename" "$vcd_arg")
    else
        args_resolved+=("$arg")
    fi
done
# Replace positional parameters with resolved args
set -- "${args_resolved[@]}"

# Global output control for LLM_orch recursion.
# Only consume --no-print before the passthrough separator (`--`);
# after that, flags belong to the leaf command.
NO_PRINT=false
if [[ -n "${HDLFORGE_NOPRINT:-}" && "${HDLFORGE_NOPRINT:-0}" != "0" ]]; then
    NO_PRINT=true
fi
args_filtered=()
seen_dd=false
for arg in "$@"; do
    if [ "$seen_dd" = true ]; then
        args_filtered+=("$arg")
        continue
    fi
    if [[ "$arg" == "--" ]]; then
        seen_dd=true
        args_filtered+=("$arg")
        continue
    fi
    if [[ "$arg" == "--no-print" ]]; then
        NO_PRINT=true
        continue
    fi
    if [[ "$arg" == "--dry-run" ]]; then
        DRY_RUN=true
        export HDLFORGE_DRY_RUN=1
        continue
    fi
    args_filtered+=("$arg")
done
set -- "${args_filtered[@]}"

hdlforge_inject_default_eval_json "$@" || exit 1
set -- "${HDLFORGE_DEFAULT_EVAL_JSON_ARGS[@]}"

CURRENT_EVAL_JSON_MODE=false
current_has_tool=false
for arg in "$@"; do
    if [[ "$arg" == "--" ]]; then
        break
    fi
    if [[ "$arg" == "--tool" ]]; then
        current_has_tool=true
        continue
    fi
    if [[ "$arg" == "--eval_json" ]]; then
        CURRENT_EVAL_JSON_MODE=true
        continue
    fi
done

if [ "$CURRENT_EVAL_JSON_MODE" = true ]; then
    CURRENT_EVAL_JSON_MODE=true
    NO_PRINT=true
    export HDLFORGE_NOPRINT=1
fi

# Change to project directory (only if PROJECT_DIR is set)
if [ -n "$PROJECT_DIR" ]; then
    cd "$PROJECT_DIR" || {
        echo "❌ Failed to cd into project directory: $PROJECT_DIR"
        exit 1
    }
fi

# Source bashrc quietly to load helper functions, then refresh repository paths
source ~/.bashrc >/dev/null 2>&1
if ! command -v update_repo_path >/dev/null 2>&1; then
    echo "❌ update_repo_path is not available after sourcing ~/.bashrc"
    exit 1
fi
update_repo_path

if [ -z "$REPO_TOP" ]; then
    echo "❌ Not inside a Git repository. Please run hdlforge from within a Git repository."
    exit 1
fi

# Use FABRINETES to find tasks directory (already validated at script start)
TASKS_DIR="$FABRINETES/hdlforge/project_setup"
SCRIPT_PATH="$TASKS_DIR/hdlforge"
shell_id="$PPID"
timestamp=$(date +%Y%m%d)
time=$(date +%H%M%S)

# Set ROOT_FOLDER to project file location (was HDLFORGE_ORIG_PATH)
# Only set if PROJECT_DIR is available
if [ -n "$PROJECT_DIR" ]; then
    export ROOT_FOLDER="$PROJECT_DIR"
else
    export ROOT_FOLDER="$(pwd)"
fi

hdlforge_apply_env_state "$@"
set -- "${HDLFORGE_FILTERED_ARGS[@]}"

mkdir -p "$TASKS_DIR/logs"
log_file="$TASKS_DIR/logs/hdlforge_${timestamp}_pid${shell_id}.log"

# Change to the tasks directory before running python
cd "$TASKS_DIR" || {
    echo "❌ Failed to cd into $TASKS_DIR"
    echo "run update_repo_path correctly."
    exit 1
}

# If no commands are passed, default to --list
if [ $# -eq 0 ]; then
    set -- --list
fi

# Check if --tool is in arguments before the passthrough separator (LLM
# orchestration mode detection). Arguments after `--` belong to the leaf command
# and must not force this wrapper out of LLM_orch mode.
has_tool_flag=false
for arg in "$@"; do
    if [[ "$arg" == "--" ]]; then
        break
    fi
    if [[ "$arg" == "--tool" ]]; then
        has_tool_flag=true
        break
    fi
done

# Eval-json and command mode both use the LLM_orch command expansion path. Keep
# --tool out of the outer invocation; tool details belong inside the expanded
# command.
eval_json_mode=false
json_path_mode=false
cmd_mode=false
for arg in "$@"; do
    if [[ "$arg" == "--" ]]; then
        break
    fi
    if [[ "$arg" == "--eval_json" ]]; then
        eval_json_mode=true
        json_path_mode=true
        continue
    fi
    if [[ "$arg" == "--cmd" && "$has_tool_flag" = false ]]; then
        cmd_mode=true
    fi
done

if [ "$cmd_mode" = true ]; then
    eval_json_mode=true
fi

if [ "$json_path_mode" = true ]; then
    NO_PRINT=true
    export HDLFORGE_NOPRINT=1
fi

if [ "$eval_json_mode" = true ]; then
    for arg in "$@"; do
        if [[ "$arg" == "--tool" ]]; then
            echo "[!x!] Error: --tool cannot be used with --eval_json or top-level --cmd"
            hdlforge_print_usage
            exit 1
        fi
    done
fi

# If --tool is not present, enter explicit LLM orchestration mode.
if [ "$has_tool_flag" = false ]; then
    if [ "$eval_json_mode" = false ]; then
        echo "[!x!] Error: --tool is required unless --eval_json is used"
        hdlforge_print_usage
        exit 1
    fi

    # Find project JSON file
    PROJECT_JSON=""
    PROJECT_JSON_DIR=""
    SEARCH_DIR="${PROJECT_DIR:-$(pwd)}"
    
    # First, try to use PROJECT_FILE_PATH if it was set
    if [ -n "$PROJECT_FILE_PATH" ] && [[ "$PROJECT_FILE_PATH" == *.hdlforge.json ]]; then
        PROJECT_JSON="$PROJECT_FILE_PATH"
    else
        # Look for project files in current directory or PROJECT_DIR
        cd "$SEARCH_DIR" || {
            echo "[!x!] Failed to cd into directory: $SEARCH_DIR"
            exit 1
        }
        
        hdlforge_json_files=$(ls *.hdlforge.json 2>/dev/null | head -1)
        if [ -n "$hdlforge_json_files" ]; then
            PROJECT_JSON="$(realpath "$hdlforge_json_files")"
        fi
    fi
    
    if [ -z "$PROJECT_JSON" ] || [ ! -f "$PROJECT_JSON" ]; then
        if [ "$cmd_mode" = true ]; then
            PROJECT_JSON=""
            PROJECT_JSON_DIR="$(realpath -m "$SEARCH_DIR")"
        else
            echo "[!x!] Error: --tool is required or project JSON file not found"
            hdlforge_print_usage
            exit 1
        fi
    else
        PROJECT_JSON_DIR="$(dirname "$PROJECT_JSON")"
    fi
    
    # Check if jq is available
    if [ "$cmd_mode" != true ] && ! command -v jq >/dev/null 2>&1; then
        echo "[!x!] Error: jq is required for LLM orchestration mode"
        echo "[i] Install jq: sudo apt-get install jq (or equivalent for your system)"
        exit 1
    fi
    
    # Build JSON path from remaining arguments (skip flags like --project).
    # --append appends one shell command fragment to the JSON command.
    # Anonymous passthrough is intentionally rejected.
    JSON_PATH_PARTS=()
    APPEND_ARGS=()
    EVAL_JSON=false
    CMD_MODE=false
    CMD_COMMAND=""
    skip_next=false
    expect_append=false
    expect_cmd=false
    for arg in "$@"; do
        if [ "$expect_cmd" = true ]; then
            if [ "$CMD_MODE" = true ]; then
                echo "[!x!] Error: only one --cmd is supported"
                hdlforge_print_usage
                exit 1
            fi
            CMD_MODE=true
            CMD_COMMAND="$arg"
            expect_cmd=false
            continue
        fi
        if [ "$expect_append" = true ]; then
            if [ ${#APPEND_ARGS[@]} -gt 0 ]; then
                echo "[!x!] Error: only one --append is supported"
                hdlforge_print_usage
                exit 1
            fi
            APPEND_ARGS+=("$arg")
            expect_append=false
            continue
        fi
        # Skip --project and its value if present
        if [[ "$arg" == "--project" ]]; then
            skip_next=true
            continue
        fi
        if [ "$skip_next" = true ]; then
            skip_next=false
            continue
        fi
        if [[ "$arg" == "--" ]]; then
            echo "[!x!] Error: anonymous passthrough is not supported in LLM_orch commands"
            hdlforge_print_usage
            exit 1
        fi
        if [[ "$arg" == "--eval_json" ]]; then
            EVAL_JSON=true
            continue
        fi
        if [[ "$arg" == "--cmd" ]]; then
            expect_cmd=true
            continue
        fi
        if [[ "$arg" == "--append" ]]; then
            expect_append=true
            continue
        fi
        if [[ "$arg" == "--eval_json_append" ]]; then
            echo "[!x!] Error: --eval_json_append was renamed to --append"
            hdlforge_print_usage
            exit 1
        fi
        if [[ "$arg" == "--eval_json_arg" ]]; then
            echo "[!x!] Error: --eval_json_arg was replaced by --append"
            hdlforge_print_usage
            exit 1
        fi
        if [[ "$arg" == --* ]]; then
            echo "[!x!] Error: unsupported JSON command option: $arg"
            hdlforge_print_usage
            exit 1
        fi
        # Only add non-flag arguments (those that don't start with --) to the path
        if [[ "$arg" != --* ]]; then
            JSON_PATH_PARTS+=("$arg")
        fi
    done

    if [ "$expect_append" = true ]; then
        echo "[!x!] Error: --append requires VALUE"
        hdlforge_print_usage
        exit 1
    fi
    if [ "$expect_cmd" = true ]; then
        echo "[!x!] Error: --cmd requires VALUE"
        hdlforge_print_usage
        exit 1
    fi

    # Enforce a single dotted JSON path token before `--`
    if [ "$CMD_MODE" = true ]; then
        if [ "$EVAL_JSON" = true ]; then
            echo "[!x!] Error: --cmd cannot be combined with --eval_json"
            hdlforge_print_usage
            exit 1
        fi
        if [ ${#JSON_PATH_PARTS[@]} -ne 0 ]; then
            echo "[!x!] Error: --cmd takes one quoted shell-command string"
            hdlforge_print_usage
            exit 1
        fi
        JSON_PATH="--cmd"
        NODE_TYPE="string"
        COMMAND="$CMD_COMMAND"
    elif [ ${#JSON_PATH_PARTS[@]} -eq 0 ]; then
        echo "[!x!] Error: No command path provided"
        hdlforge_print_usage
        exit 1
    elif [ ${#JSON_PATH_PARTS[@]} -ne 1 ]; then
        echo "[!x!] Error: JSON path must be a single dotted token"
        hdlforge_print_usage
        exit 1
    else
        JSON_PATH="${JSON_PATH_PARTS[0]}"
    fi
    
    if [ "$CMD_MODE" != true ]; then
        NODE_TYPE=$(jq -r --arg json_path "$JSON_PATH" 'getpath($json_path | split(".")) | type' "$PROJECT_JSON" 2>/dev/null)

        if ([ -z "$NODE_TYPE" ] || [ "$NODE_TYPE" = "null" ]) && [[ "$JSON_PATH" != LLM_orch.* ]]; then
            JSON_PATH_CANDIDATE="LLM_orch.${JSON_PATH}"
            NODE_TYPE_CANDIDATE=$(jq -r --arg json_path "$JSON_PATH_CANDIDATE" 'getpath($json_path | split(".")) | type' "$PROJECT_JSON" 2>/dev/null)
            if [ -n "$NODE_TYPE_CANDIDATE" ] && [ "$NODE_TYPE_CANDIDATE" != "null" ]; then
                JSON_PATH="$JSON_PATH_CANDIDATE"
                NODE_TYPE="$NODE_TYPE_CANDIDATE"
            fi
        fi

        if [ -z "$NODE_TYPE" ] || [ "$NODE_TYPE" = "null" ]; then
            echo "[!x!] Error: Command not found at JSON path: ${JSON_PATH}"
            echo "[i] Available command-like string paths:"
            jq -r 'paths(strings) as $p | "  " + ($p | join("."))' "$PROJECT_JSON" 2>/dev/null | head -20 || echo "  (unable to parse JSON structure)"
            exit 1
        fi

        if [ "$NODE_TYPE" = "object" ] || [ "$NODE_TYPE" = "array" ]; then
            echo "Run options for ${JSON_PATH}:"
            jq -r --arg json_path "$JSON_PATH" --arg prefix "${JSON_PATH_PARTS[0]}" '
                getpath($json_path | split(".")) |
                paths(scalars) as $p |
                "  hdlforge --eval_json \($prefix).\($p | join("."))"' \
                "$PROJECT_JSON" 2>/dev/null || echo "  (unable to list runnable paths)"
            exit 0
        fi

        if [ "$NODE_TYPE" != "string" ]; then
            echo "[!x!] Error: ${JSON_PATH} resolves to ${NODE_TYPE}, but JSON commands must be strings."
            exit 1
        fi

        # Fetch command from JSON using jq
        COMMAND=$(jq -r --arg json_path "$JSON_PATH" 'getpath($json_path | split("."))' "$PROJECT_JSON" 2>/dev/null)
    fi

    if [ -z "$COMMAND" ]; then
        echo "[!x!] Error: Empty command at JSON path: ${JSON_PATH}"
        exit 1
    fi
    
    for _append_arg in "${APPEND_ARGS[@]}"; do
        COMMAND="${COMMAND} ${_append_arg}"
    done
    
    # Execute the fetched command recursively
    if [ "$NO_PRINT" = false ]; then
        if [ "$CMD_MODE" = true ]; then
            echo "[i] HDLForge Command Mode: --cmd"
        else
            echo "[i] JSON Command Mode: ${JSON_PATH}"
        fi
        echo "[i] Executing: ${COMMAND}"
        echo ""
    fi

    if [ "$DRY_RUN" = true ] && [ "$CMD_MODE" = true ]; then
        echo "[i] HDLForge dry-run: --cmd command resolved"
        echo "[i] Working directory: $PROJECT_JSON_DIR"
        echo "[i] Command: ${COMMAND}"
        echo "[i] --cmd execution skipped"
        exit 0
    fi
    
    # Change to project directory (where JSON file is located) before executing
    cd "$PROJECT_JSON_DIR" || {
        echo "[!x!] Failed to cd into project directory: $PROJECT_JSON_DIR"
        exit 1
    }
    
    # Execute the command (recursive call to hdlforge)
    # Use eval to properly handle quoted arguments in the command.
    eval "$COMMAND"
    exit $?
fi

echo "--------$(pwd): $Date: $timestamp Time $time------" >> "$log_file"

# Export original directory for Python scripts that need to resolve relative paths
export HDLFORGE_ORIG_DIR="$ORIG_DIR"

if [ "$DRY_RUN" = true ]; then
    echo "[i] HDLForge dry-run: final --tool command resolved"
    echo "[i] Working directory: $(pwd)"
    echo "[i] Command: $(hdlforge_shell_quote_args python3 "$TASKS_DIR/tasks.py" "$@")"
    echo "[i] --tool execution skipped"
    exit 0
fi

# Execute the command
exec python3 "$TASKS_DIR/tasks.py" "$@" | tee -a "$log_file"

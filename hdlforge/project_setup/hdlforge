#!/bin/bash

set -o pipefail

# =============================================================================
# FABRINETES must be set - it points to the Fabrinetes repository root
# =============================================================================
if [ -z "$FABRINETES" ]; then
    echo "❌ FABRINETES environment variable is not set."
    echo ""
    echo "Please set FABRINETES to point to the Fabrinetes repository root:"
    echo "  export FABRINETES=/path/to/Fabrinetes"
    echo ""
    echo "Add this to your ~/.bashrc or shell profile for persistence."
    exit 1
fi

if [ ! -d "$FABRINETES/hdlforge/project_setup" ]; then
    echo "❌ Invalid FABRINETES path: $FABRINETES"
    echo "   Directory not found: $FABRINETES/hdlforge/project_setup"
    exit 1
fi
# =============================================================================

# Check if any arguments are provided
if [ $# -lt 1 ]; then
    # Look for existing project files in current directory (JSON first, then TOML)
    hdlforge_json_files=$(ls *.hdlforge.json 2>/dev/null)
    hdlforge_toml_files=$(ls *.hdlforge.toml 2>/dev/null)
    hdlforge_files="$hdlforge_json_files"$'\n'"$hdlforge_toml_files"
    hdlforge_files=$(echo "$hdlforge_files" | grep -v '^$' | head -1)
    
    if [ -n "$hdlforge_files" ] && [ $(echo "$hdlforge_files" | wc -l) -eq 1 ]; then
        # Exactly one file found - use it in the example
        example_file=$(echo "$hdlforge_files" | head -1)
        echo "Usage: hdlforge [--project <project_file>] --tool <tool_name> [--arg value --arg value...]"
        echo ""
        echo "Available Tools:"
        echo "  vivado        - FPGA Development Tasks (synthesis, implementation, bitstream)"
        echo "  Verilator     - Simulation Tasks (build, sim)"
        echo "  network       - Network Utilities (raw packet sending)"
        echo "  vcd_analyzer  - VCD Waveform Analysis"
        echo "  tsharkWrapper - tshark Command Wrapper"
        echo "  hw_server     - Interactive FPGA Tools (program, ILA/VIO, JTAG)"
        echo "  projects      - Project Management"
        echo ""
        echo "hdlforge auto-detected project file in the current directory: $example_file"
    else
        echo "Usage: hdlforge [--project <project_file>] --tool <tool_name> [--arg value --arg value...]"
        echo ""
        echo "Available Tools:"
        echo "  vivado        - FPGA Development Tasks (synthesis, implementation, bitstream)"
        echo "  Verilator     - Simulation Tasks (build, sim)"
        echo "  network       - Network Utilities (raw packet sending)"
        echo "  vcd_analyzer  - VCD Waveform Analysis"
        echo "  tsharkWrapper - tshark Command Wrapper"
        echo "  hw_server     - Interactive FPGA Tools (program, ILA/VIO, JTAG)"
        echo "  projects      - Project Management"
        echo ""
        echo "Note: --project is optional. If omitted, hdlforge will auto-detect *.hdlforge.json or *.hdlforge.toml files in the current directory."
    fi
    exit 1
fi

# Check if command requires --project argument
if [[ "$1" == "help" || "$1" == "projects" ]]; then
    # Commands that don't need --project parameter
    PROJECT_FILE=""
    PROJECT_FILE_PATH=""
    PROJECT_DIR=""
    PROJECT_FILENAME=""
else
    # Commands that need --project parameter
    # Extract project file from --project argument
    PROJECT_FILE=""
    PROJECT_FILE_PATH=""
    PROJECT_DIR=""
    PROJECT_FILENAME=""
    
    # Parse arguments to find --project
    args=("$@")
    for i in "${!args[@]}"; do
        if [[ "${args[i]}" == "--project" && $((i+1)) -lt ${#args[@]} ]]; then
            PROJECT_FILE="${args[i+1]}"
            break
        fi
    done
    
    # Note: --project is now optional; Python layer will handle auto-detection
    
    # Only process project file if it was provided
    if [ -n "$PROJECT_FILE" ]; then
        # Resolve project file path (handle both relative and absolute paths)
        if [[ "$PROJECT_FILE" == /* ]]; then
            # Absolute path
            PROJECT_FILE_PATH="$PROJECT_FILE"
        else
            # Relative path - resolve relative to current directory
            PROJECT_FILE_PATH="$(realpath "$PROJECT_FILE")"
        fi
        
        # Check if project file exists
        if [ ! -f "$PROJECT_FILE_PATH" ]; then
            echo "❌ Project file not found: $PROJECT_FILE_PATH"
            exit 1
        fi
        
        # Get the directory containing the project file
        PROJECT_DIR="$(dirname "$PROJECT_FILE_PATH")"
        PROJECT_FILENAME="$(basename "$PROJECT_FILE_PATH")"
    else
        # No project file specified - will be auto-detected by Python
        # Set PROJECT_DIR to current directory
        PROJECT_DIR="$(pwd)"
        PROJECT_FILENAME=""
    fi
fi

# Resolve --vcdfilename path to absolute BEFORE changing directories
# This ensures relative paths work from the invocation location
ORIG_DIR="$(pwd)"
args_resolved=()
skip_next=false
for i in $(seq 1 $#); do
    if [ "$skip_next" = true ]; then
        skip_next=false
        continue
    fi
    arg="${!i}"
    next_i=$((i + 1))
    if [[ "$arg" == "--vcdfilename" && $next_i -le $# ]]; then
        vcd_arg="${!next_i}"
        skip_next=true
        # Resolve to absolute path if relative
        if [[ "$vcd_arg" != /* ]]; then
            vcd_arg="$(cd "$ORIG_DIR" && realpath "$vcd_arg" 2>/dev/null || echo "$ORIG_DIR/$vcd_arg")"
        fi
        args_resolved+=("--vcdfilename" "$vcd_arg")
    else
        args_resolved+=("$arg")
    fi
done
# Replace positional parameters with resolved args
set -- "${args_resolved[@]}"

# Change to project directory (only if PROJECT_DIR is set)
if [ -n "$PROJECT_DIR" ]; then
    cd "$PROJECT_DIR" || {
        echo "❌ Failed to cd into project directory: $PROJECT_DIR"
        exit 1
    }
fi

# Source bashrc and run update_repo_path from project directory
source ~/.bashrc
update_repo_path

if [ -z "$REPO_TOP" ]; then
    echo "❌ Not inside a Git repository. Please run hdlforge from within a Git repository."
    exit 1
fi

# Use FABRINETES to find tasks directory (already validated at script start)
TASKS_DIR="$FABRINETES/hdlforge/project_setup"
SCRIPT_PATH="$TASKS_DIR/hdlforge"
shell_id="$PPID"
timestamp=$(date +%Y%m%d)
time=$(date +%H%M%S)

# Set ROOT_FOLDER to project file location (was HDLFORGE_ORIG_PATH)
# Only set if PROJECT_DIR is available
if [ -n "$PROJECT_DIR" ]; then
    export ROOT_FOLDER="$PROJECT_DIR"
else
    export ROOT_FOLDER="$(pwd)"
fi
mkdir -p "$TASKS_DIR/logs"
log_file="$TASKS_DIR/logs/hdlforge_${timestamp}_pid${shell_id}.log"

# Change to the tasks directory before running python
cd "$TASKS_DIR" || {
    echo "❌ Failed to cd into $TASKS_DIR"
    echo "run update_repo_path correctly."
    exit 1
}

# If no commands are passed, default to --list
if [ $# -eq 0 ]; then
    set -- --list
fi

# Check if --tool is in arguments (LLM orchestration mode detection)
has_tool_flag=false
for arg in "$@"; do
    if [[ "$arg" == "--tool" ]]; then
        has_tool_flag=true
        break
    fi
done

# If --tool is not present, enter LLM orchestration mode
if [ "$has_tool_flag" = false ]; then
    # Find project JSON file
    PROJECT_JSON=""
    
    # First, try to use PROJECT_FILE_PATH if it was set
    if [ -n "$PROJECT_FILE_PATH" ] && [[ "$PROJECT_FILE_PATH" == *.hdlforge.json ]]; then
        PROJECT_JSON="$PROJECT_FILE_PATH"
    else
        # Look for project files in current directory or PROJECT_DIR
        SEARCH_DIR="${PROJECT_DIR:-$(pwd)}"
        cd "$SEARCH_DIR" || {
            echo "[!x!] Failed to cd into directory: $SEARCH_DIR"
            exit 1
        }
        
        hdlforge_json_files=$(ls *.hdlforge.json 2>/dev/null | head -1)
        if [ -n "$hdlforge_json_files" ]; then
            PROJECT_JSON="$(realpath "$hdlforge_json_files")"
        fi
    fi
    
    if [ -z "$PROJECT_JSON" ] || [ ! -f "$PROJECT_JSON" ]; then
        echo "[!x!] Error: --tool is required or project JSON file not found"
        echo "[i] Usage: hdlforge --tool <tool_name> [options...]"
        echo "[i] Or provide a project JSON file (*.hdlforge.json) with LLM_orch configuration"
        exit 1
    fi
    
    # Check if jq is available
    if ! command -v jq >/dev/null 2>&1; then
        echo "[!x!] Error: jq is required for LLM orchestration mode"
        echo "[i] Install jq: sudo apt-get install jq (or equivalent for your system)"
        exit 1
    fi
    
    # Build JSON path from remaining arguments (skip flags like --project).
    # Optional `--` separates the dotted LLM_orch path from extra args forwarded to the leaf command.
    # Example: hdlforge testing.base.sim.build_and_run -- --extra-env "TESTCASE=arp_test,DEBUG=1"
    JSON_PATH_PARTS=()
    PASSTHROUGH_ARGS=()
    seen_dd=false
    skip_next=false
    for arg in "$@"; do
        # Skip --project and its value if present
        if [[ "$arg" == "--project" ]]; then
            skip_next=true
            continue
        fi
        if [ "$skip_next" = true ]; then
            skip_next=false
            continue
        fi
        if [ "$seen_dd" = true ]; then
            PASSTHROUGH_ARGS+=("$arg")
            continue
        fi
        if [[ "$arg" == "--" ]]; then
            seen_dd=true
            continue
        fi
        # Only add non-flag arguments (those that don't start with --) to the path
        if [[ "$arg" != --* ]]; then
            JSON_PATH_PARTS+=("$arg")
        fi
    done
    
    # Enforce a single dotted LLM_orch path token before `--`
    if [ ${#JSON_PATH_PARTS[@]} -eq 0 ]; then
        echo "[!x!] Error: No command path provided"
        echo "[i] Usage: hdlforge <dotted.path> [-- <extra-args-for-leaf-command>]"
        echo "[i] Example: hdlforge testing.base.sim.build_and_run -- --extra-env \"TESTCASE=arp_test\""
        exit 1
    fi
    if [ ${#JSON_PATH_PARTS[@]} -ne 1 ]; then
        echo "[!x!] Error: LLM_orch path must be a single dotted token"
        echo "[i] Use dots instead of spaces, e.g.: hdlforge testing.arp_test.sim.build_and_run"
        exit 1
    fi
    
    JSON_PATH="LLM_orch.${JSON_PATH_PARTS[0]}"
    
    # Fetch command from JSON using jq
    COMMAND=$(jq -r ".${JSON_PATH}" "$PROJECT_JSON" 2>/dev/null)
    
    if [ -z "$COMMAND" ] || [ "$COMMAND" = "null" ] || [ "$COMMAND" = "" ]; then
        echo "[!x!] Error: Command not found at JSON path: ${JSON_PATH}"
        echo "[i] Available paths in LLM_orch:"
        jq -r '.LLM_orch | paths(scalars) as $p | "  LLM_orch." + ($p | join("."))' "$PROJECT_JSON" 2>/dev/null | head -20 || echo "  (unable to parse JSON structure)"
        exit 1
    fi
    
    # Append shell-escaped passthrough args (everything after `--`) to the leaf command
    COMMAND_SUFFIX=""
    for _pt in "${PASSTHROUGH_ARGS[@]}"; do
        COMMAND_SUFFIX="${COMMAND_SUFFIX} $(printf '%q' "$_pt")"
    done
    
    # Execute the fetched command recursively
    echo "[i] LLM Orchestration Mode: ${JSON_PATH}"
    echo "[i] Executing: ${COMMAND}${COMMAND_SUFFIX}"
    echo ""
    
    # Change to project directory (where JSON file is located) before executing
    PROJECT_JSON_DIR="$(dirname "$PROJECT_JSON")"
    cd "$PROJECT_JSON_DIR" || {
        echo "[!x!] Failed to cd into project directory: $PROJECT_JSON_DIR"
        exit 1
    }
    
    # Execute the command (recursive call to hdlforge)
    # Use eval to properly handle quoted arguments in the command and passthrough
    eval "$COMMAND${COMMAND_SUFFIX}"
    exit $?
fi

echo "--------$(pwd): $Date: $timestamp Time $time------" >> "$log_file"

# Export original directory for Python scripts that need to resolve relative paths
export HDLFORGE_ORIG_DIR="$ORIG_DIR"

# Execute the command
exec python3 "$TASKS_DIR/tasks.py" "$@" | tee -a "$log_file"
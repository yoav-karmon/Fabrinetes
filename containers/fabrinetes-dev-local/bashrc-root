# ~/.bashrc: executed by bash(1) for non-login shells.
# Function to print only in interactive shells

print_if_interactive() {
    if [[ $is_interactive_shell -eq 1 ]] || [[ $- == *i* ]]; then
        echo "$@"
    fi
}


# Function to remove duplication from PATH-like variables
remove_duplicates_from_path() {
    local path_var="$1"
    local -a path_array
    local -a unique_paths
    local path_item
    
    # Split PATH by colon into array
    IFS=':' read -ra path_array <<< "$path_var"
    
    # Track seen paths to avoid duplicates (case-sensitive)
    declare -A seen_paths
    
    # Build unique paths array (preserving order, first occurrence kept)
    for path_item in "${path_array[@]}"; do
        # Skip empty entries
        [ -z "$path_item" ] && continue
        
        # Check if we've seen this path before
        if [ -z "${seen_paths[$path_item]}" ]; then
            seen_paths[$path_item]=1
            unique_paths+=("$path_item")
        fi
    done
    
    # Join unique paths back with colon
    local result
    printf -v result '%s:' "${unique_paths[@]}"
    # Remove trailing colon
    echo "${result%:}"
}


add_to_pythonpath() {
    local path_to_add="$1"
    
    # Prepend REPO_TOP if path doesn't start with /
    if [ -n "$REPO_TOP" ] && [ "${path_to_add#/}" = "$path_to_add" ]; then
        path_to_add="$REPO_TOP/$path_to_add"
    fi
    
    # Check if path already exists in PYTHONPATH
    if [ -n "$PYTHONPATH" ]; then
        local -a pythonpath_array
        IFS=':' read -ra pythonpath_array <<< "$PYTHONPATH"
        for existing_path in "${pythonpath_array[@]}"; do
            if [ "$existing_path" = "$path_to_add" ]; then
                # Path already exists, skip adding
                return 0
            fi
        done
    fi
    
    # Path doesn't exist, add it
    iprint "[+] adding $path_to_add to PYTHONPATH"
    export PYTHONPATH="${path_to_add}${PYTHONPATH:+:${PYTHONPATH}}"
}

# Add to PATH (prepends REPO_TOP if path is relative)
add_to_path() {
    local path_to_add="$1"
    
    # Prepend REPO_TOP if path doesn't start with /
    if [ -n "$REPO_TOP" ] && [ "${path_to_add#/}" = "$path_to_add" ]; then
        path_to_add="$REPO_TOP/$path_to_add"
    fi
    
    # Check if path already exists in PATH
    if [ -n "$PATH" ]; then
        local -a path_array
        IFS=':' read -ra path_array <<< "$PATH"
        for existing_path in "${path_array[@]}"; do
            if [ "$existing_path" = "$path_to_add" ]; then
                # Path already exists, skip adding
                return 0
            fi
        done
    fi
    iprint "[+] adding $path_to_add to PATH"
    # Path doesn't exist, add it
    export PATH="${path_to_add}${PATH:+:${PATH}}"
}

# Print function that only prints if shell is interactive
iprint() {
    # Check if shell is interactive
    if [[ $- == *i* ]]; then
        echo "$@"
    fi
}


init_print() {
    # Only print if INIT_PATH was NOT defined when script started (first run)
    if [ -z "$_INIT_PATH_WAS_DEFINED" ]; then
        # Check if shell is interactive
        if [[ $- == *i* ]]; then
            echo "$@"
        fi
    fi
}

print_env_vars() {
    # Print ALL environment variables
    init_print "=== All Environment Variables ==="
    env | sort | while IFS='=' read -r name value; do
        init_print "$name: $value"
    done
        init_print "=================================="
}



print_key_env_vars() {
    # Print only key environment variables (for quick reference)
    iprint "=== Key Environment Variables ==="
    
    # Print PATH entries, one per line, sorted
    iprint "PATH:"
    if [ -n "$PATH" ]; then
        local -a path_array
        IFS=':' read -ra path_array <<< "$PATH"
        # Sort and print each entry
        printf '%s\n' "${path_array[@]}" | sort | while IFS= read -r path_entry; do
            [ -n "$path_entry" ] && iprint "  $path_entry"
        done
    else
        iprint "  (empty)"
    fi
    
    # Print PYTHONPATH entries, one per line, sorted
    iprint "PYTHONPATH:"
    if [ -n "$PYTHONPATH" ]; then
        local -a pythonpath_array
        IFS=':' read -ra pythonpath_array <<< "$PYTHONPATH"
        # Sort and print each entry
        printf '%s\n' "${pythonpath_array[@]}" | sort | while IFS= read -r pythonpath_entry; do
            [ -n "$pythonpath_entry" ] && iprint "  $pythonpath_entry"
        done
    else
        iprint "  (empty)"
    fi
    
    
    
    iprint "REPO_TOP: $REPO_TOP"
    iprint "=================================="
}

# Define function to configure REPO_TOP and PYTHONPATH
update_repo_path() {
    # Require Bash
    if [ -z "$BASH_VERSION" ]; then
        echo "[X] This function requires Bash." >&2
        return 1
    fi

    # Reset PATH and PYTHONPATH to initial values if INIT_PATH and INIT_PYTHONPATH are set
    if [ -n "$INIT_PATH" ]; then
        export PATH="$INIT_PATH"
        # Clean duplicates from INIT_PATH in case it has any
        export PATH=$(remove_duplicates_from_path "$PATH")
    fi
    if [ -n "$INIT_PYTHONPATH" ]; then
        export PYTHONPATH="$INIT_PYTHONPATH"
        # Clean duplicates from INIT_PYTHONPATH in case it has any
        export PYTHONPATH=$(remove_duplicates_from_path "$PYTHONPATH")
    fi

    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
    
    if [[ -z "$repo_root" ]]; then
        iprint "[!]  Not inside a Git repository."
        export REPO_TOP=""
        return 1
    fi
    export REPO_TOP="$repo_root"
    init_repo_env_file="$REPO_TOP/init_repo_env.sh"
    if [[ -f "$init_repo_env_file" ]]; then
        source "$init_repo_env_file"
        iprint "[i] sourcing $init_repo_env_file"
        
        # Clean duplicates after sourcing repo-specific paths
        if [ -n "$PATH" ]; then
            export PATH=$(remove_duplicates_from_path "$PATH")
        fi
        if [ -n "$PYTHONPATH" ]; then
            export PYTHONPATH=$(remove_duplicates_from_path "$PYTHONPATH")
        fi
    else
        iprint "[i]  Repo $REPO_TOP missing $init_repo_env_file"
    fi

    iprint "[v] REPO_TOP set to $REPO_TOP"
    
    # Print updated environment variables nicely
    iprint ""
    print_key_env_vars
}



# Git prompt helper (optional)
parse_git_branch() {
    git rev-parse --git-dir > /dev/null 2>&1 || return
    branch="$(git symbolic-ref --short HEAD 2>/dev/null || git describe --tags --exact-match 2>/dev/null)"
    [ -n "$branch" ] && echo "($branch)"
}

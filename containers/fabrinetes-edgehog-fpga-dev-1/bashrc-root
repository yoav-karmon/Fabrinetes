
# Function to remove duplication from PATH-like variables
source /etc/bashrc-func
iprint "bashrc-root: started"

# Print function that only prints on first run (when INIT_PATH is not yet defined)
# Capture the initial state: if INIT_PATH exists at script start, it's not first run
_INIT_PATH_WAS_DEFINED=${INIT_PATH:+yes}


# Detect first run of this bashrc file (container initialization)
init_print "bashrc-root: this is bashrc first run un seesion start"
if [ -z "$INIT_PATH" ] && [ -z "$BASHRC_INITIALIZED" ]; then
    # This is the first run - clean and save initial PATH and PYTHONPATH
    
    # Remove duplicates from PATH and save to INIT_PATH
    if [ -n "$PATH" ]; then
        INIT_PATH=$(remove_duplicates_from_path "$PATH")
        export INIT_PATH
    else
        export INIT_PATH=""
    fi
    
    # Remove duplicates from PYTHONPATH and save to INIT_PYTHONPATH
    if [ -n "$PYTHONPATH" ]; then
        INIT_PYTHONPATH=$(remove_duplicates_from_path "$PYTHONPATH")
        export INIT_PYTHONPATH
    else
        export INIT_PYTHONPATH=""
    fi
    
    # Mark that initialization has been done
    export BASHRC_INITIALIZED=1
fi


# ~/.bashrc: executed by bash(1) for non-login shells.
# Read hostname from /etc/hostname and set HOSTNAME_ENTRY
if [ -r /etc/hostname ]; then
    HOSTNAME_ENTRY=$(cat /etc/hostname | tr -d '\n' | tr -d ' ')
else
    HOSTNAME_ENTRY="${HOSTNAME}"
fi
export HOSTNAME_ENTRY

init_print "bashrc-root: sourcing init_env.sh"
source /etc/profile.d/init_env.sh

# Clean duplicates after sourcing init_env.sh (Vivado settings may add duplicates)
if [ -n "$PATH" ]; then
    export PATH=$(remove_duplicates_from_path "$PATH")
fi
if [ -n "$PYTHONPATH" ]; then
    export PYTHONPATH=$(remove_duplicates_from_path "$PYTHONPATH")
fi

export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"
export GIT_CONFIG_SYSTEM="/etc/gitconfig"
export GIT_AUTHOR_NAME="${USER:-$(id -un)}"
export GIT_AUTHOR_EMAIL="${USER:-$(id -un)}@${HOSTNAME_ENTRY}"
export GIT_COMMITTER_NAME="${USER:-$(id -un)}"
export GIT_COMMITTER_EMAIL="${USER:-$(id -un)}@${HOSTNAME_ENTRY}"
# Additional environment variables for development tools
export EDITOR="nano"
export PAGER="less"
init_print "bashrc-root: ensuring gitconfig exists"
if [ ! -f "$HOME/.gitconfig" ]; then
    git config --global user.name "${USER:-$(id -un)}"
    git config --global user.email "${USER:-$(id -un)}@${HOSTNAME_ENTRY}"
    git config --global init.defaultBranch main
    git config --global core.autocrlf false
    git config --global core.filemode false
fi

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# uncomment for a colored prompt, if the terminal has the capability; turned
# off by default to not distract the user: the focus in a terminal window
# should be on the output of commands, not on the prompt
#force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	# We have color support; assume it's compliant with Ecma-48
	# (ISO/IEC-6429). (Lack of such support is extremely rare, and such
	# a case would tend to support setf rather than setaf.)
	color_prompt=yes
    else
	color_prompt=
    fi
fi


# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.bash_aliases, instead of adding them here directly.
# See /usr/share/doc/bash-doc/examples in the bash-doc package.

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then   
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
init_print "bashrc-root: setting PS1"
PS1='\[\033[1;35m\]\u@${HOSTNAME_ENTRY}-${HOSTNAME_server}\[\033[0m\]:\[\033[1;33m\]\w\[\033[0m\] \[\033[1;36m\]$(parse_git_branch)\[\033[0m\]\$ '

print_env_vars
print_key_env_vars
iprint "bashrc-root: completed successfully"
iprint ""
